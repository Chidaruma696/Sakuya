<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("clientes.cuenta.titulo", nombre: @cliente.nombre) %></h1>
  <%= link_to t("clientes.titulo"), clientes_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
  <div class="card"><div class="etiqueta-dato"><%= t("clientes.debe") %></div><div class="valor-dato text-2xl" id="saldo"><%= pesos(@cuenta.saldo_centavos) %></div></div>
  <div class="card"><div class="etiqueta-dato"><%= t("clientes.limite_credito") %></div><div class="valor-dato text-2xl"><%= pesos(@cliente.limite_credito_centavos) %></div></div>
  <% @cuenta.antiguedad.each do |cubeta, centavos| %>
    <div class="card"><div class="etiqueta-dato"><%= t("clientes.cuenta.dias", rango: cubeta) %></div><div class="valor-dato text-xl <%= 'text-red-700' if centavos.positive? && cubeta != "0-30" %>"><%= pesos(centavos) %></div></div>
  <% end %>
</div>

<% if puede?("clientes.abonar") %>
  <div class="card mb-6">
    <h2 class="mb-2 font-semibold"><%= t("clientes.cuenta.abonar") %></h2>
    <% if @corte %>
      <%= form_with url: abonar_cliente_path(@cliente), class: "flex flex-wrap items-end gap-3 text-sm" do |f| %>
        <div><%= f.label :monto, t("comun.monto"), class: "etiqueta-campo" %><%= f.number_field :monto, step: "0.01", min: "0.01", required: true, class: "entrada w-36 font-mono" %></div>
        <div><%= f.label :forma, t("compras.forma"), class: "etiqueta-campo" %><%= f.select :forma, Pago::FORMAS.map { |x| [ t("formas_pago.#{x}"), x ] }, {}, class: "entrada" %></div>
        <div class="grow"><%= f.label :notas, t("comun.notas"), class: "etiqueta-campo" %><%= f.text_field :notas, class: "entrada" %></div>
        <%= f.submit t("clientes.cuenta.registrar_abono"), class: "btn btn-primary" %>
      <% end %>
      <p class="mt-2 text-xs text-stone-500"><%= t("clientes.cuenta.entra_al_corte", folio: @corte.folio) %></p>
    <% else %>
      <p class="text-sm text-stone-600"><%= t("clientes.cuenta.sin_caja") %></p>
    <% end %>
  </div>
<% end %>

<table class="tabla">
  <thead><tr><th><%= t("comun.fecha") %></th><th><%= t("clientes.cuenta.concepto") %></th><th class="text-right"><%= t("clientes.cuenta.cargo") %></th><th class="text-right"><%= t("clientes.cuenta.abono_col") %></th><th class="text-right"><%= t("clientes.debe") %></th><th><%= t("comun.quien") %></th></tr></thead>
  <tbody>
    <% @movimientos.each do |m, saldo| %>
      <tr>
        <td class="px-3 py-2"><%= l m.fecha %></td>
        <td class="px-3 py-2"><%= m.referencia.is_a?(Venta) ? link_to(m.motivo, caja_ticket_path(m.referencia), class: "enlace") : m.motivo %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(m.monto_centavos) if m.monto_centavos.positive? %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(-m.monto_centavos) if m.monto_centavos.negative? %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(saldo) %></td>
        <td class="px-3 py-2"><%= m.usuario %></td>
      </tr>
    <% end %>
    <% if @movimientos.empty? %><tr><td colspan="6" class="px-3 py-6 text-center text-stone-500"><%= t("clientes.cuenta.sin_movimientos") %></td></tr><% end %>
  </tbody>
</table>
