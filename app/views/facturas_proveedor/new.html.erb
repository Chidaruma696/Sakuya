<h1 class="mb-1 text-2xl font-bold"><%= t("compras.nueva_factura") %></h1>
<p class="mb-4 text-sm text-stone-600"><%= t("compras.factura_ayuda") %></p>
<%= form_with model: @factura, url: facturas_path, scope: :factura, class: "formulario", data: { controller: "renglones", renglones_url_value: buscar_productos_path } do |f| %>
  <div class="campos">
    <div>
      <%= f.label :proveedor_id, t("compras.proveedor"), class: "block text-sm font-medium" %>
      <%= f.collection_select :proveedor_id, @proveedores, :id, :nombre, { include_blank: "—" }, required: true, class: "entrada" %>
    </div>
    <div><%= f.label :folio, t("compras.folio_proveedor"), class: "block text-sm font-medium" %><%= f.text_field :folio, required: true, class: "entrada font-mono", placeholder: t("compras.folio_proveedor_ayuda") %></div>
    <div><%= f.label :fecha, t("comun.fecha"), class: "block text-sm font-medium" %><%= f.date_field :fecha, required: true, class: "entrada" %></div>
    <div><%= f.label :vence, t("compras.vence"), class: "block text-sm font-medium" %><%= f.date_field :vence, class: "entrada" %><p class="mt-1 text-xs text-stone-500"><%= t("compras.vence_ayuda") %></p></div>
    <div><%= f.label :monto, t("compras.monto_sin_renglones"), class: "block text-sm font-medium" %><%= f.number_field :monto, step: "0.01", min: 0, class: "entrada font-mono" %><p class="mt-1 text-xs text-stone-500"><%= t("compras.monto_sin_renglones_ayuda") %></p></div>
    <div><%= f.label :concepto, t("compras.concepto"), class: "block text-sm font-medium" %><%= f.text_field :concepto, class: "entrada" %></div>
  </div>
  <div class="rounded-lg border border-stone-200 p-4">
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <label class="text-sm font-medium" for="escaner"><%= icono("upc-scan", t("compras.escanear")) %></label>
      <input id="escaner" type="text" autocomplete="off" data-renglones-target="escaner" data-action="keydown->renglones#escanear" placeholder="<%= t("compras.escanear_ayuda") %>" class="entrada mt-0 max-w-md font-mono">
      <span data-renglones-target="aviso" class="text-sm text-amber-700"></span>
    </div>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="w-36 py-1"><%= t("comun.cantidad") %></th><th class="w-28 py-1"><%= t("compras.cajas") %></th><th class="w-36 py-1"><%= t("compras.precio_compra") %></th><th class="w-10"></th></tr></thead>
      <tbody data-renglones-target="cuerpo">
        <%= f.fields_for :lineas do |l| %>
          <tr data-renglones-target="fila">
            <td class="py-1 pr-2"><%= l.collection_select :producto_id, @productos, :id, ->(p) { "#{p.nombre} (#{p.unidad_corta})" }, { include_blank: "—" }, class: "entrada mt-0" %></td>
            <td class="py-1 pr-2"><%= l.number_field :cantidad, step: "0.001", min: "0.001", data: { campo: "cantidad" }, class: "entrada mt-0 font-mono" %></td>
            <td class="py-1 pr-2"><%= l.number_field :cajas, min: 0, placeholder: "0", class: "entrada mt-0 font-mono" %></td>
            <td class="py-1 pr-2"><%= l.number_field :precio, step: "0.01", min: "0.01", class: "entrada mt-0 font-mono" %></td>
            <td class="py-1"><button type="button" data-action="renglones#quitar" class="btn btn-ghost-danger btn-sm"><i class="bi bi-x-lg"></i></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="button" data-action="renglones#nuevo" class="btn btn-secondary mt-3">+ <%= t("comun.renglon") %></button>
  </div>
  <% if @sueltas.any? %>
    <div class="rounded-lg border border-stone-200 p-4">
      <h2 class="mb-1 text-sm font-medium"><%= t("compras.recepciones_a_ligar") %></h2>
      <p class="mb-2 text-xs text-stone-500"><%= t("compras.recepciones_a_ligar_ayuda") %></p>
      <div class="grid gap-1 text-sm sm:grid-cols-2 lg:grid-cols-3">
        <% @sueltas.each do |r| %>
          <label class="flex items-center gap-2"><%= check_box_tag "factura[recepcion_ids][]", r.id, false, id: "recepcion_#{r.id}" %> <span class="font-mono"><%= r.folio %></span> · <%= r.proveedor %> · <%= l r.fecha %><%= " · #{r.remision}" if r.remision.present? %></label>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @candado %>
    <div>
      <%= f.label :motivo, t("compras.motivo_exceso"), class: "block text-sm font-medium" %>
      <%= f.text_field :motivo, class: "entrada max-w-xl" %>
      <p class="mt-1 text-xs text-stone-500"><%= t("compras.candado_aviso") %></p>
    </div>
  <% end %>
  <%= f.submit t("compras.registrar_factura"), class: "btn btn-primary btn-lg" %>
<% end %>
