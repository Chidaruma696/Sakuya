<% x = @factura %>
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("compras.factura") %> <span class="font-mono"><%= x.folio %></span><%= tag.span(" · #{t("compras.estados.cancelada")}", class: "text-red-700") if x.cancelada? %></h1>
  <%= link_to icono("arrow-left", t("compras.facturas")), facturas_path, class: "btn btn-ghost btn-sm" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= link_to x.proveedor.nombre, cuenta_path(x.proveedor), class: "enlace" %> · <%= l x.fecha %><%= " · #{t("compras.vence").downcase} #{l x.vence}" if x.vence %> · <%= x.usuario %><%= " · #{x.concepto}" if x.concepto.present? %><%= " · #{x.motivo_cancelacion}" if x.cancelada? %></p>
<div class="mb-4 grid gap-4 md:grid-cols-3">
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("caja.monto") %></div><div class="font-mono text-3xl"><%= pesos(x.monto_centavos) %></div></div>
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("compras.pagado") %></div><div class="font-mono text-3xl"><%= pesos(x.pagado_centavos) %></div></div>
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("compras.resta") %></div><div class="font-mono text-3xl <%= 'text-red-700' if x.vencida? %>"><%= pesos(x.resta_centavos) %></div>
    <% if x.abierta? && !x.pagada? && puede?("compras.pagar") %><%= link_to icono("cash-coin", t("compras.pagar")), cuenta_path(x.proveedor, factura: x.id), class: "btn btn-success btn-sm mt-2" %><% end %></div>
</div>
<div class="grid gap-4 lg:grid-cols-2">
  <div class="card">
    <h2 class="mb-2 font-semibold"><%= t("compras.facturado_vs_recibido") %> <% unless x.cancelada? %><% er = x.estado_recepcion %><span class="rounded px-2 py-0.5 text-xs font-semibold <%= { 'completa' => 'bg-green-100 text-green-800', 'parcial' => 'bg-amber-100 text-amber-800', 'sin_recepcion' => 'bg-red-100 text-red-800' }[er] %>"><%= t("compras.recepcion_estado.#{er}") %></span><% end %></h2>
    <p class="mb-2 text-xs text-stone-500"><%= t("compras.comparativo_ayuda") %></p>
    <% if @comparativo.empty? %>
      <p class="text-sm text-stone-500"><%= t("compras.sin_renglones_ni_recepciones") %></p>
    <% else %>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="py-1 text-right"><%= t("compras.facturado") %></th><th class="py-1 text-right"><%= t("compras.recibido") %></th><th class="py-1 text-right"><%= t("compras.diferencia") %></th></tr></thead>
        <tbody>
          <% @comparativo.each do |c| %>
            <tr class="border-t border-stone-100 <%= { 'faltante' => 'text-red-700', 'sin_recibir' => 'text-red-700', 'sobrante' => 'text-amber-700', 'sin_facturar' => 'text-amber-700' }[c.estado] %>">
              <td class="py-1"><%= c.producto.nombre %></td>
              <td class="py-1 text-right font-mono"><%= cantidad(c.facturado, c.producto) %></td>
              <td class="py-1 text-right font-mono"><%= cantidad(c.recibido, c.producto) %></td>
              <td class="py-1 text-right font-mono"><%= c.estado == "cuadra" ? "✓" : "#{c.diferencia.positive? ? "+" : ""}#{cantidad(c.diferencia, c.producto)}" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <% if x.lineas.any? %>
      <h3 class="mt-4 mb-1 text-sm font-semibold"><%= t("compras.renglones") %></h3>
      <table class="w-full text-sm">
        <% x.lineas.each do |l| %>
          <tr class="border-t border-stone-100"><td class="py-1"><%= l.producto.nombre %></td><td class="py-1 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td><td class="py-1 text-right font-mono"><%= pesos(l.precio_centavos) %></td><td class="py-1 text-right font-mono"><%= pesos(l.importe_centavos) %></td></tr>
        <% end %>
      </table>
    <% end %>
  </div>
  <div class="space-y-4">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("compras.recepciones_ligadas") %></h2>
      <% if x.recepciones.any? %>
        <ul class="text-sm">
          <% x.recepciones.each do |r| %>
            <li class="flex items-center justify-between border-t border-stone-100 py-1"><span><%= link_to r.folio, recepcion_path(r), class: "chip-folio" %> · <%= l r.fecha %> · <%= r.sucursal %></span>
              <% if x.abierta? && puede?("compras.facturar") %><%= button_to t("compras.desligar"), factura_recepcion_path(r), method: :patch, params: { factura_proveedor_id: "" }, class: "btn btn-ghost btn-xs" %><% end %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-stone-500"><%= t("compras.ninguna_recepcion") %></p>
      <% end %>
      <% if x.abierta? && @sueltas.any? && puede?("compras.facturar") %>
        <h3 class="mt-3 mb-1 text-xs uppercase text-stone-500"><%= t("compras.recepciones_sueltas") %></h3>
        <ul class="text-sm">
          <% @sueltas.each do |r| %>
            <li class="flex items-center justify-between border-t border-stone-100 py-1"><span><%= link_to r.folio, recepcion_path(r), class: "chip-folio" %> · <%= l r.fecha %><%= " · #{r.remision}" if r.remision.present? %></span>
              <%= button_to t("compras.ligar"), factura_recepcion_path(r), method: :patch, params: { factura_proveedor_id: x.id }, class: "btn btn-secondary btn-xs" %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("compras.pagos") %></h2>
      <% if x.pagos.any? %>
        <table class="w-full text-sm">
          <% x.pagos.each do |p| %>
            <tr class="border-t border-stone-100 <%= 'text-stone-400 line-through' unless p.vigente? %>"><td class="py-1"><%= l p.created_at, format: :short %></td><td class="py-1"><%= t("formas_pago.#{p.forma}") %><%= " · #{p.referencia}" if p.referencia.present? %></td><td class="py-1"><%= p.usuario %></td><td class="py-1 text-right font-mono"><%= pesos(p.monto_centavos) %></td></tr>
          <% end %>
        </table>
      <% else %>
        <p class="text-sm text-stone-500"><%= t("compras.sin_pagos") %></p>
      <% end %>
    </div>
    <% if x.abierta? && puede?("compras.facturar") %>
      <div class="card">
        <h2 class="mb-2 font-semibold"><%= t("compras.cancelar_factura") %></h2>
        <p class="mb-2 text-xs text-stone-500"><%= t("compras.cancelar_factura_ayuda") %></p>
        <%= form_with url: cancelar_factura_path(x), class: "flex flex-wrap gap-2 text-sm", data: { turbo_confirm: t("compras.confirmar_cancelar", folio: x.folio) } do |f| %>
          <%= f.text_field :motivo, placeholder: t("comun.motivo").downcase, required: true, class: "entrada mt-0 flex-1" %>
          <%= f.submit t("comun.cancelar"), class: "btn btn-ghost-danger btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
