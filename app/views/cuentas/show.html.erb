<% p = @proveedor %>
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= p.nombre %></h1>
  <%= link_to icono("arrow-left", t("compras.cuentas_por_pagar")), cuentas_path, class: "btn btn-ghost btn-sm" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= [ p.contacto, p.telefono, p.rfc ].compact_blank.join(" · ") %><%= " · #{t("compras.dias_credito").downcase}: #{p.dias_credito}" %> · <%= link_to t("comun.editar").downcase, edit_proveedor_path(p), class: "enlace" if puede?("compras.facturar") %></p>
<div class="mb-4 grid gap-4 md:grid-cols-3">
  <div class="card">
    <div class="text-xs uppercase text-stone-500"><%= t("compras.debemos") %></div>
    <div class="font-mono text-3xl"><%= pesos(p.saldo_centavos) %></div>

    <div class="mt-2 flex flex-wrap gap-2">
      <%= link_to icono("file-earmark-plus", t("compras.nueva_factura")), new_factura_path(proveedor_id: p), class: "btn btn-secondary btn-xs" if puede?("compras.facturar") %>
      <%= link_to icono("list-ul", t("compras.facturas")), facturas_path(proveedor_id: p), class: "btn btn-ghost btn-xs" %>
    </div>
  </div>
  <% if puede?("compras.pagar") %>
    <div class="card md:col-span-2">
      <h2 class="mb-1 font-semibold"><%= t("compras.pagar") %></h2>
      <p class="mb-2 text-xs text-stone-500"><%= @corte ? t("compras.pago_sale_de_caja", sucursal: sucursal_actual) : t("compras.pago_sin_caja", sucursal: sucursal_actual) %></p>
      <%= form_with url: pagar_cuenta_path(p), class: "campos-4 text-sm" do |f| %>
        <div><%= f.label :factura_proveedor_id, t("compras.factura"), class: "block text-xs text-stone-500" %>
          <%= f.select :factura_proveedor_id, @facturas.map { |x| [ "#{x.folio} · #{t("compras.resta").downcase} #{pesos(x.resta_centavos)}", x.id ] }, { include_blank: t("compras.a_cuenta"), selected: params[:factura] }, class: "entrada mt-0" %></div>
        <div><%= f.label :monto, t("caja.monto"), class: "block text-xs text-stone-500" %><%= f.number_field :monto, step: "0.01", min: "0.01", required: true, class: "entrada mt-0 font-mono" %></div>
        <div><%= f.label :forma, t("compras.forma"), class: "block text-xs text-stone-500" %><%= f.select :forma, Pago::FORMAS.map { |x| [ t("formas_pago.#{x}"), x ] }, {}, class: "entrada mt-0" %></div>
        <div><%= f.label :referencia, t("compras.referencia"), class: "block text-xs text-stone-500" %><%= f.text_field :referencia, class: "entrada mt-0" %></div>
        <div class="md:col-span-2 xl:col-span-4"><%= f.submit t("compras.registrar_pago"), class: "btn btn-success" %></div>
      <% end %>
    </div>
  <% end %>
</div>
<div class="grid gap-4 lg:grid-cols-2">
  <div>
    <h2 class="mb-2 font-semibold"><%= t("compras.facturas_abiertas") %></h2>
    <table class="tabla">
      <thead><tr><th><%= t("comun.folio") %></th><th><%= t("comun.fecha") %></th><th><%= t("compras.vence") %></th><th class="text-right"><%= t("caja.monto") %></th><th class="text-right"><%= t("compras.resta") %></th></tr></thead>
      <tbody>
        <% @facturas.each do |x| %>
          <tr class="<%= 'text-red-700' if x.vencida? %>"><td class="px-3 py-2"><%= link_to x.folio, factura_path(x), class: "chip-folio" %></td><td class="px-3 py-2 whitespace-nowrap"><%= l x.fecha %></td><td class="px-3 py-2 whitespace-nowrap"><%= l x.vence if x.vence %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(x.monto_centavos) %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(x.resta_centavos) %></td></tr>
        <% end %>
        <% if @facturas.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-stone-500"><%= t("compras.sin_facturas_abiertas") %></td></tr><% end %>
      </tbody>
    </table>
    <h2 class="mt-4 mb-2 font-semibold"><%= t("compras.pagos") %></h2>
    <table class="tabla">
      <thead><tr><th><%= t("comun.fecha") %></th><th><%= t("compras.factura") %></th><th><%= t("compras.forma") %></th><th><%= t("comun.quien") %></th><th class="text-right"><%= t("caja.monto") %></th><th></th></tr></thead>
      <tbody>
        <% @pagos.each do |g| %>
          <tr class="<%= 'text-stone-400' unless g.vigente? %>">
            <td class="px-3 py-2 whitespace-nowrap"><%= l g.created_at, format: :short %></td>
            <td class="px-3 py-2"><%= g.factura ? link_to(g.factura.folio, factura_path(g.factura), class: "chip-folio") : t("compras.a_cuenta") %></td>
            <td class="px-3 py-2"><%= t("formas_pago.#{g.forma}") %><%= " · #{g.referencia}" if g.referencia.present? %></td>
            <td class="px-3 py-2"><%= g.usuario %></td>
            <td class="px-3 py-2 text-right font-mono <%= 'line-through' unless g.vigente? %>"><%= pesos(g.monto_centavos) %></td>
            <td class="px-3 py-2 text-right">
              <% if g.vigente? && puede?("compras.pagar") && (g.retiro.nil? || g.corte&.abierto?) %>
                <%= form_with url: anular_pago_path(g), class: "flex gap-1", data: { turbo_confirm: t("compras.confirmar_anular", monto: pesos(g.monto_centavos)) } do |f| %>
                  <%= f.text_field :motivo, placeholder: t("comun.motivo").downcase, required: true, class: "entrada mt-0 w-32 text-xs" %>
                  <%= f.submit t("compras.anular"), class: "btn btn-ghost-danger btn-xs" %>
                <% end %>
              <% elsif !g.vigente? %><span class="text-xs"><%= g.motivo_anulacion %></span><% end %>
            </td>
          </tr>
        <% end %>
        <% if @pagos.empty? %><tr><td colspan="6" class="px-3 py-6 text-center text-stone-500"><%= t("compras.sin_pagos") %></td></tr><% end %>
      </tbody>
    </table>
  </div>
  <div>
    <h2 class="mb-2 font-semibold"><%= t("compras.libro") %></h2>
    <table class="tabla">
      <thead><tr><th><%= t("comun.fecha") %></th><th><%= t("comun.tipo") %></th><th><%= t("comun.concepto") %></th><th class="text-right">±</th><th class="text-right"><%= t("compras.saldo") %></th></tr></thead>
      <tbody>
        <% @movimientos.each do |m| %>
          <tr><td class="px-3 py-1 whitespace-nowrap"><%= l m.fecha %></td><td class="px-3 py-1"><%= t("compras.movimientos.#{m.tipo}") %></td><td class="px-3 py-1 text-stone-600"><%= m.concepto %> <span class="text-xs">(<%= m.usuario %>)</span></td>
            <td class="px-3 py-1 text-right font-mono <%= m.delta_centavos.negative? ? 'text-emerald-700' : '' %>"><%= pesos(m.delta_centavos) %></td><td class="px-3 py-1 text-right font-mono"><%= pesos(m.saldo_centavos) %></td></tr>
        <% end %>
        <% if @movimientos.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-stone-500"><%= t("inventario.sin_movimientos") %></td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
