<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("purchases.suppliers") %></h1>
  <%= link_to icon("plus-lg", t("purchases.new_supplier")), new_supplier_path, class: "btn btn-primary" if can?("purchases.invoice") %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("purchases.suppliers_help") %></p>
<table class="table">
  <thead><tr><th><%= t("common.name") %></th><th><%= t("purchases.contact") %></th><th><%= t("purchases.phone") %></th><th><%= t("purchases.tax_id") %></th><th class="text-right"><%= t("purchases.credit_days") %></th><th class="text-right"><%= t("purchases.balance") %></th><th></th></tr></thead>
  <tbody>
    <% @suppliers.each do |p| %>
      <tr class="<%= 'text-stone-400' unless p.active %>">
        <td class="px-3 py-2 font-medium"><%= p.name %><%= " (#{t("purchases.inactive")})" unless p.active %></td>
        <td class="px-3 py-2"><%= p.contact %></td><td class="px-3 py-2"><%= p.phone %></td><td class="px-3 py-2 font-mono text-xs"><%= p.tax_id %></td>
        <td class="px-3 py-2 text-right font-mono"><%= p.credit_days %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(@balances[p.id] || 0) %></td>
        <td class="px-3 py-2 text-right whitespace-nowrap">
          <%= link_to icon("wallet2", t("purchases.account")), account_path(p), class: "btn btn-secondary btn-xs" %>
          <%= link_to icon("pencil", t("common.edit")), edit_supplier_path(p), class: "btn btn-ghost btn-xs" if can?("purchases.invoice") %>
        </td>
      </tr>
    <% end %>
    <% if @suppliers.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("purchases.no_suppliers") %></td></tr><% end %>
  </tbody>
</table>
