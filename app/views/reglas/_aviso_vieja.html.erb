<%# La regla vigente se escribió para un contrato anterior del gancho: que se note antes de que falle. %>
<% if regla&.vieja? %>
  <p class="mb-4 max-w-3xl rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" id="aviso_vieja">
    <i class="bi bi-exclamation-triangle-fill"></i> <%= t("reglas.vieja", suya: regla.version, actual: Regla.contrato(regla.gancho)) %>
  </p>
<% end %>
