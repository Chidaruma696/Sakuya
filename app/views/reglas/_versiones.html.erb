<%# Las versiones de una regla en Lisp, la vigente arriba. ambito = tablero | regla_corte (de ahí salen los textos). %>
<section class="mt-8">
  <h2 class="mb-2 text-lg font-semibold"><%= t("#{ambito}.versiones") %></h2>
  <table class="tabla">
    <thead><tr><th><%= t("comun.fecha") %></th><th><%= t("comun.quien") %></th><th></th></tr></thead>
    <tbody>
      <% versiones.each_with_index do |v, i| %>
        <tr>
          <td class="px-3 py-2"><%= l v.created_at, format: :short %> <span class="text-xs text-stone-500" title="<%= t("reglas.contrato_ayuda") %>"><%= t("reglas.contrato", n: v.version) %></span><% if i.zero? %> <span class="badge"><%= t("#{ambito}.vigente") %></span><% end %></td>
          <td class="px-3 py-2"><%= v.usuario %></td>
          <td class="px-3 py-2 text-right"><% unless i.zero? %><%= button_to t("#{ambito}.restaurar"), restaurar.(v), class: "btn btn-secondary btn-xs" %><% end %></td>
        </tr>
      <% end %>
      <% if versiones.empty? %><tr><td colspan="3" class="px-3 py-6 text-center text-stone-500"><%= t("#{ambito}.sin_versiones") %></td></tr><% end %>
    </tbody>
  </table>
</section>
