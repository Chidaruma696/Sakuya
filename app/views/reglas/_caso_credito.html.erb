<div><label for="cliente_id" class="etiqueta-campo"><%= t("#{textos}.caso.cliente") %></label>
  <%= select_tag :cliente_id, options_for_select([ [ t("#{textos}.caso.inventado"), "" ] ] + Cliente.activos.order(:nombre).limit(300).map { |c| [ c.nombre, c.id ] }, caso[:cliente]&.id), id: "cliente_id" %></div>
<div><label for="monto" class="etiqueta-campo"><%= t("#{textos}.caso.monto") %></label>
  <%= number_field_tag :monto, format("%.2f", caso[:monto] / 100r), step: "0.01", min: 0, id: "monto", class: "w-32 font-mono" %></div>
<% unless caso[:cliente] %>
  <div><label for="saldo" class="etiqueta-campo"><%= t("#{textos}.caso.saldo") %></label>
    <%= number_field_tag :saldo, format("%.2f", caso[:saldo] / 100r), step: "0.01", id: "saldo", class: "w-32 font-mono" %></div>
  <div><label for="limite" class="etiqueta-campo"><%= t("#{textos}.caso.limite") %></label>
    <%= number_field_tag :limite, format("%.2f", caso[:limite] / 100r), step: "0.01", min: 0, id: "limite", class: "w-32 font-mono" %></div>
<% else %>
  <p class="pb-2 text-stone-600"><%= t("#{textos}.caso.cuenta", saldo: pesos(caso[:cliente].saldo_centavos), limite: pesos(caso[:cliente].limite_credito_centavos)) %></p>
<% end %>
