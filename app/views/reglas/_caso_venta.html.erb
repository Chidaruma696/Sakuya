<div><label for="claves" class="etiqueta-campo"><%= t("#{textos}.caso.claves") %></label>
  <%= text_field_tag :claves, caso[:claves], id: "claves", class: "w-56 font-mono uppercase" %></div>
<div><label for="total" class="etiqueta-campo"><%= t("#{textos}.caso.total") %></label>
  <%= number_field_tag :total, format("%.2f", caso[:total] / 100r), step: "0.01", min: 0, id: "total", class: "w-32 font-mono" %></div>
<div><label for="forma" class="etiqueta-campo"><%= t("#{textos}.caso.forma") %></label>
  <%= select_tag :forma, options_for_select(Pago::FORMAS.map { |f| [ t("formas_pago.#{f}"), f ] }, caso[:forma]), id: "forma" %></div>
<div><label for="hora" class="etiqueta-campo"><%= t("#{textos}.caso.hora") %></label>
  <%= number_field_tag :hora, caso[:hora], step: 1, min: 0, max: 23, id: "hora", class: "w-20 font-mono" %></div>
<div class="basis-full border-t border-stone-100 pt-3"><label for="venta" class="etiqueta-campo"><%= t("regla_precio.caso.venta") %></label>
  <%= text_field_tag :venta, caso[:folio_venta], id: "venta", class: "w-40 font-mono uppercase", placeholder: "B-00012" %></div>
