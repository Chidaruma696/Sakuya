<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("customers.title") %></h1>
  <%= link_to icon("plus-lg", t("customers.new")), new_customer_path, class: "btn btn-primary" if can?("customers.edit") %>
</div>
<%= form_with url: customers_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= search_field_tag :q, params[:q], placeholder: t("customers.search"), class: "input max-w-sm" %>
<% end %>
<table class="table">
  <thead><tr><th><%= t("common.name") %></th><th><%= t("customers.phone") %></th><th><%= t("customers.tax_id") %></th><th class="text-right"><%= t("customers.credit_limit") %></th><th class="text-right"><%= t("customers.owes") %></th><th></th></tr></thead>
  <tbody>
    <% @customers.each do |c| %>
      <tr class="<%= 'text-stone-400' unless c.active %>">
        <td class="px-3 py-2 font-medium"><%= c.name %><%= " (#{t("customers.inactive")})" unless c.active %></td>
        <td class="px-3 py-2"><%= c.phone %></td><td class="px-3 py-2 font-mono text-xs"><%= c.tax_id %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(c.credit_limit_cents) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(@balances[c.id] || 0) %></td>
        <td class="px-3 py-2 text-right whitespace-nowrap">
          <%= link_to icon("wallet2", t("customers.account.title_short")), account_customer_path(c), class: "btn btn-secondary btn-xs" %>
          <%= link_to icon("pencil", t("common.edit")), edit_customer_path(c), class: "btn btn-ghost btn-xs" if can?("customers.edit") %>
        </td>
      </tr>
    <% end %>
    <% if @customers.empty? %><tr><td colspan="6" class="px-3 py-6 text-center text-stone-500"><%= t("customers.no_customers") %></td></tr><% end %>
  </tbody>
</table>
