<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("customers.title") %></h1>
  <%= link_to icon("plus-lg", t("customers.new")), new_customer_path, class: "btn btn-primary" if can?("customers.edit") %>
</div>
<%= form_with url: customers_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= search_field_tag :q, params[:q], placeholder: t("customers.search"), class: "input max-w-sm" %>
<% end %>
<% show_types = @credit_types.any? || @customers.any?(&:credit_type) %>
<% show_returnables = @returnable_counts.present? %>
<table class="table">
  <thead><tr><th><%= t("common.name") %></th><th><%= t("customers.phone") %></th><th><%= t("customers.tax_id") %></th><% if show_types %><th><%= t("customers.credit_type") %></th><% end %><th class="text-right"><%= t("customers.credit_limit") %></th><th class="text-right"><%= t("customers.owes") %></th><% if show_returnables %><th><%= t("returnables.title") %></th><% end %><th></th></tr></thead>
  <tbody>
    <% @customers.each do |c| %>
      <tr class="<%= 'text-stone-400' unless c.active %>">
        <td class="px-3 py-2 font-medium"><%= c.name %><%= " (#{t("customers.inactive")})" unless c.active %></td>
        <td class="px-3 py-2"><%= c.phone %></td><td class="px-3 py-2 font-mono text-xs"><%= c.tax_id %></td>
        <% if show_types %><td class="px-3 py-2"><%= render "credit_type", customer: c, types: @credit_types %></td><% end %>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(c.credit_limit_cents) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(@balances[c.id] || 0) %></td>
        <% if show_returnables %>
          <td class="px-3 py-2 text-xs" data-returnables>
            <% counts = @returnable_counts[c.id] || {} %>
            <%# In the order the rule declares them; what it no longer declares goes last. %>
            <% ((@returnable_names.keys & counts.keys) + (counts.keys - @returnable_names.keys)).each do |kind| %>
              <% count = counts[kind] %>
              <span class="mr-2 whitespace-nowrap <%= 'returnable-undeclared font-medium text-red-700' unless @returnable_names.key?(kind) %>"><%= @returnable_names[kind] || t("returnables.undeclared", key: kind) %>: <%= count.positive? ? count : t("returnables.count_in_favor", pieces: -count) %></span>
            <% end %>
          </td>
        <% end %>
        <td class="px-3 py-2 text-right whitespace-nowrap">
          <%= link_to icon("wallet2", t("customers.account.title_short")), account_customer_path(c), class: "btn btn-secondary btn-xs" %>
          <%= link_to icon("pencil", t("common.edit")), edit_customer_path(c), class: "btn btn-ghost btn-xs" if can?("customers.edit") %>
        </td>
      </tr>
    <% end %>
    <% if @customers.empty? %><tr><td colspan="<%= 6 + (show_types ? 1 : 0) + (show_returnables ? 1 : 0) %>" class="px-3 py-6 text-center text-stone-500"><%= t("customers.no_customers") %></td></tr><% end %>
  </tbody>
</table>
