<%= form_with model: @customer, class: "form" do |f| %>
  <% if @customer.errors.any? %><div class="rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800"><%= @customer.errors.full_messages.join(". ") %></div><% end %>
  <div class="fields">
    <div><%= f.label :name, class: "field-label" %><%= f.text_field :name, required: true, autofocus: true, class: "input" %></div>
    <div><%= f.label :phone, class: "field-label" %><%= f.telephone_field :phone, class: "input" %></div>
    <div><%= f.label :tax_id, class: "field-label" %><%= f.text_field :tax_id, class: "input font-mono" %></div>
    <div><%= f.label :address, class: "field-label" %><%= f.text_field :address, class: "input" %></div>
    <div><%= f.label :credit_limit, class: "field-label" %><%= f.number_field :credit_limit, step: "0.01", min: 0, class: "input font-mono" %><p class="mt-1 text-xs text-stone-500"><%= t("customers.limit_help") %></p></div>
    <%# The types come from the credit rule; one the rule no longer declares stays on offer so that saving does not drop it. %>
    <% types = CreditRule.types %>
    <% if types.any? || @customer.credit_type %>
      <% unknown = @customer.credit_type && !types.key?(@customer.credit_type) ? [ [ t("customers.unknown_credit_type", key: @customer.credit_type), @customer.credit_type ] ] : [] %>
      <div><%= f.label :credit_type, class: "field-label" %><%= f.select :credit_type, [ [ t("customers.no_credit_type"), "" ] ] + types.map { |key, name| [ name, key ] } + unknown, {}, class: "input" %><p class="mt-1 text-xs text-stone-500"><%= t("customers.credit_type_help") %></p></div>
    <% end %>
    <% if Rule.current("credit") || @customer.cutoff_day %>
      <div><%= f.label :cutoff_day, class: "field-label" %><%= f.select :cutoff_day, [ [ t("customers.no_cutoff_day"), "" ] ] + t("date.day_names").each_with_index.map { |day, i| [ day, i ] }, {}, class: "input" %><p class="mt-1 text-xs text-stone-500"><%= t("customers.cutoff_day_help") %></p></div>
    <% end %>
    <div><%= f.label :notes, class: "field-label" %><%= f.text_field :notes, class: "input" %></div>
    <% if @customer.persisted? %><label class="flex items-center gap-2 text-sm"><%= f.check_box :active, class: "h-4 w-4" %> <%= t("common.active") %></label><% end %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= f.submit t("common.save"), class: "btn btn-primary btn-lg" %>
    <%= link_to t("common.cancel"), customers_path, class: "btn btn-ghost btn-lg" %>
  </div>
<% end %>
