<h1 class="mb-4 text-2xl font-bold"><%= t("charges.charges") %> · <%= current_branch %></h1>
<table class="table">
  <thead><tr><th class="px-3 py-2"><%= t("common.date") %></th><th class="px-3 py-2"><%= t("stock_counts.responsible") %></th><th class="px-3 py-2"><%= t("common.origin") %></th><th class="px-3 py-2 text-right"><%= t("till.amount") %></th><th class="px-3 py-2"><%= t("common.detail") %></th><th class="px-3 py-2"><%= t("common.status") %></th><th></th></tr></thead>
  <tbody>
    <% @charges.each do |g| %>
      <tr class="border-t border-stone-100 align-top">
        <td class="px-3 py-2 whitespace-nowrap"><%= l g.created_at, format: :short %></td>
        <td class="px-3 py-2"><%= g.user %></td>
        <td class="px-3 py-2"><% if g.stock_count %><%= link_to g.stock_count.folio, stock_count_path(g.stock_count), class: "chip-folio" %><% else %><%= link_to t("charges.review"), reviews_path, class: "link" %><% end %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(g.amount_cents) %></td>
        <td class="px-3 py-2 whitespace-pre-line text-stone-600"><%= g.detail %></td>
        <td class="px-3 py-2"><%= t("statuses.#{g.status}") %><%= " · #{g.resolved_by}" if g.resolved_by %></td>
        <td class="px-3 py-2 whitespace-nowrap">
          <% if g.status == "pending" %>
            <%= button_to t("charges.paid"), resolve_charge_path(g, status: "paid"), class: "btn btn-primary btn-xs" %>
            <%= button_to t("charges.forgive"), resolve_charge_path(g, status: "forgiven"), class: "btn btn-secondary btn-xs mt-1" %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @charges.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("charges.no_charges") %></td></tr><% end %>
  </tbody>
</table>
