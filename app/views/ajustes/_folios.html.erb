<%= form_with url: ajustes_sistema_path, method: :patch, class: "formulario" do |f| %>
  <%= hidden_field_tag :volver, "folios" %>
  <% modo = @ajustes["folios.modo"] %>
  <div class="grid gap-3 md:grid-cols-2">
    <% Folio::MODOS.each do |m| %>
      <label class="opcion items-start text-base">
        <%= f.radio_button "ajuste[folios.modo]", m, checked: modo == m, class: "mt-1" %>
        <span class="flex-1"><strong><%= t("ajustes.folios.modos.#{m}") %></strong><br><span class="text-sm font-normal text-stone-600"><%= t("ajustes.folios.modos.#{m}_ayuda") %></span></span>
        <i class="bi bi-check-circle-fill opcion-check text-2xl"></i>
      </label>
    <% end %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box "ajuste[folios.sucursal]", { checked: @ajustes["folios.sucursal"] == "1" }, "1", "0" %> <%= t("ajustes.folios.sucursal") %> <span class="text-xs text-stone-500">(<%= Folio.formatear(@ajustes["folios.venta"], 42, codigo: sucursal_actual.codigo) %>)</span></label>
  <div class="campos-4">
    <label class="block text-sm"><%= t("ajustes.folios.unico") %>
      <%= f.text_field "ajuste[folios.unico]", value: @ajustes["folios.unico"], maxlength: 4, class: "entrada font-mono uppercase", placeholder: "F" %>
      <span class="mt-1 block text-xs text-stone-500"><%= t("ajustes.folios.ejemplo", folio: Folio.formatear(@ajustes["folios.unico"], 42)) %></span>
    </label>
  </div>
  <h3 class="font-semibold"><%= t("ajustes.folios.por_documento") %></h3>
  <p class="text-xs text-stone-500"><%= t("ajustes.folios.ayuda") %></p>
  <div class="campos-4">
    <% Folio::DOCUMENTOS.each_key do |doc| %>
      <label class="block text-sm"><%= t("ajustes.folios.documentos.#{doc}") %>
        <%= f.text_field "ajuste[folios.#{doc}]", value: @ajustes["folios.#{doc}"], maxlength: 4, class: "entrada font-mono uppercase" %>
        <span class="mt-1 block text-xs text-stone-500"><%= Folio.formatear(@ajustes["folios.#{doc}"], 42) %></span>
      </label>
    <% end %>
  </div>
  <%= f.submit t("ajustes.guardar"), class: "btn btn-primary btn-lg" %>
<% end %>
