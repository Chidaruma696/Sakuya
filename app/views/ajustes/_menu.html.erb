<%# El menú de Ajustes. Abajo, las opciones avanzadas: todo lo que se programa en el Lisp de Sakuya. %>
<% secciones = [ [ "para_ti", "person-gear" ] ] %>
<% secciones += [ [ "negocio", "receipt" ], [ "folios", "123" ], [ "modulos", "grid-1x2" ], [ "caja", "cash-stack" ] ] if puede?("admin.usuarios") %>
<% secciones << [ "compras", "truck" ] if puede?("admin.usuarios") && Modulo.activo?("compras") %>
<% avanzadas = [] %>
<% if puede?("reglas.editar") %>
  <% avanzadas = [ [ "tablero", "braces", tablero_editar_path ], [ "regla_corte", "cash-coin", regla_editar_path("corte") ], [ "regla_precio", "tag", regla_editar_path("precio") ], [ "regla_venta", "cart-check", regla_editar_path("venta") ],
                   [ "regla_retiro", "safe", regla_editar_path("retiro") ], [ "regla_movimiento", "box-seam", regla_editar_path("movimiento") ] ] %>
  <% avanzadas += [ [ "regla_recepcion", "truck", regla_editar_path("recepcion") ], [ "regla_factura", "receipt-cutoff", regla_editar_path("factura") ] ] if Modulo.activo?("compras") %>
  <% avanzadas << [ "archivo_reglas", "file-earmark-code", archivo_reglas_path ] %>
<% end %>
<% clase = ->(activa) { "flex items-center gap-3 rounded-md px-3 py-2 text-sm whitespace-nowrap #{activa ? 'bg-white font-semibold text-marca-900 shadow-sm ring-1 ring-marca-200' : 'text-stone-700 hover:bg-white'}" } %>
<nav class="lg:sticky lg:top-[calc(var(--cinta-alto,0px)+1rem)] lg:self-start" aria-label="<%= t("ajustes.titulo") %>">
  <h1 class="mb-3 px-2 text-2xl font-bold"><%= t("ajustes.titulo") %></h1>
  <ul class="flex gap-1 overflow-x-auto lg:flex-col">
    <% secciones.each do |id, icono| %>
      <li>
        <%= link_to ajustes_seccion_path(id), class: clase.(actual == id) do %>
          <i class="bi bi-<%= icono %> w-5 text-center text-lg leading-none text-stone-500"></i><span><%= t("ajustes.secciones.#{id}") %></span>
        <% end %>
      </li>
    <% end %>
    <% if avanzadas.any? %>
      <li class="mt-3 hidden px-3 pb-1 text-[0.6875rem] font-semibold tracking-wider text-stone-500 uppercase lg:block"><%= t("ajustes.avanzadas") %></li>
      <% avanzadas.each do |id, icono, ruta| %>
        <li>
          <%= link_to ruta, class: clase.(actual == id) do %>
            <i class="bi bi-<%= icono %> w-5 text-center text-lg leading-none text-stone-500"></i><span><%= t("ajustes.secciones.#{id}") %></span>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>
</nav>
