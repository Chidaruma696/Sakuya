<h1 class="mb-4 text-2xl font-bold"><%= t("inventario.entrada_o_ajuste") %> · <%= @sucursal %></h1>
<%= form_with url: movimientos_inventario_path(sucursal_id: @sucursal.id), class: "formulario" do |f| %>
  <div class="campos-4">
    <div class="md:col-span-2">
      <%= f.label :producto_id, t("comun.producto"), class: "etiqueta-campo" %>
      <%= f.select :producto_id, Producto.activos.order(:nombre).map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, { selected: @movimiento.producto_id }, class: "entrada" %>
    </div>
    <div>
      <%= f.label :tipo, t("comun.tipo"), class: "etiqueta-campo" %>
      <%= f.select :tipo, %w[entrada ajuste_entrada ajuste_salida merma].map { |x| [ t("movimientos.#{x}"), x ] }, { selected: @movimiento.tipo }, class: "entrada" %>
    </div>
    <div>
      <%= f.label :cantidad, t("comun.cantidad"), class: "etiqueta-campo" %>
      <%= f.number_field :cantidad, step: "0.001", min: "0.001", value: @movimiento.cantidad, required: true, class: "entrada font-mono" %>
    </div>
    <div class="md:col-span-2 xl:col-span-4">
      <%= f.label :motivo, t("comun.motivo"), class: "etiqueta-campo" %>
      <%= f.text_field :motivo, value: @movimiento.motivo, required: true, class: "entrada" %>
    </div>
  </div>
  <% unless puede?("inventario.ajustar") || Regla.vigente("movimiento") %>
    <p class="text-xs text-stone-600"><%= t("inventario.queda_por_revisar") %></p>
  <% end %>
  <%= f.submit t("inventario.registrar"), class: "btn btn-primary btn-lg" %>
<% end %>
