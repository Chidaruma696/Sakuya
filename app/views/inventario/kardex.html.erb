<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("inventario.kardex") %> · <%= @sucursal %><%= " · #{@producto.nombre}" if @producto %></h1>
  <%= render "selector_sucursal" %>
</div>
<table class="tabla">
  <thead><tr><th class="px-3 py-2"><%= t("comun.fecha") %></th><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2"><%= t("comun.tipo") %></th><th class="px-3 py-2 text-right"><%= t("comun.cantidad") %></th><th class="px-3 py-2 text-right"><%= t("comun.saldo") %></th><th class="px-3 py-2"><%= t("comun.quien") %></th><th class="px-3 py-2"><%= t("comun.motivo") %></th></tr></thead>
  <tbody>
    <% @movimientos.each do |m| %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 whitespace-nowrap"><%= l m.created_at, format: :short %></td>
        <td class="px-3 py-2"><%= m.producto.nombre %></td>
        <td class="px-3 py-2"><%= m.nombre_tipo %></td>
        <td class="px-3 py-2 text-right font-mono <%= m.entrada? ? 'text-green-700' : 'text-red-700' %>"><%= m.entrada? ? "+" : "−" %><%= number_with_precision(m.cantidad, precision: m.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(m.saldo, precision: m.producto.decimales) %></td>
        <td class="px-3 py-2"><%= m.usuario.nombre %></td>
        <td class="px-3 py-2 text-stone-600"><%= m.motivo %></td>
      </tr>
    <% end %>
    <% if @movimientos.empty? %><tr><td colspan="8" class="px-3 py-6 text-center text-stone-500"><%= t("inventario.sin_movimientos") %></td></tr><% end %>
  </tbody>
</table>
