<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("inicio.titulo") %> · <%= @todas ? t("comun.todas_las_sucursales") : @sucursal %></h1>
  <% if puede?("reglas.editar") %><%= link_to tablero_editar_path, class: "btn btn-secondary btn-sm" do %><i class="bi bi-braces"></i> <%= t("tablero.personalizar") %><% end %><% end %>
</div>
<%= render "filtro" %>
<%= render "por_revisar" %>
<% if @tablero_error && puede?("reglas.editar") %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
    <span><i class="bi bi-exclamation-triangle-fill text-corbata-700"></i> <%= t("tablero.error_html", error: content_tag(:code, @tablero_error)) %></span>
    <%= link_to t("tablero.arreglar"), tablero_editar_path, class: "btn btn-secondary btn-sm" %>
  </div>
<% end %>
<%= render "tablero" %>
