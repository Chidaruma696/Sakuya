<% if Modulo.activo?("conteos") %>
  <div class="card">
    <h2 class="mb-2 font-semibold"><%= t("inicio.conteos") %></h2>
    <% @toca_contar.each do |s| %><p class="mb-1 rounded bg-amber-50 px-2 py-1 text-sm font-semibold text-amber-800"><%= s.nombre %>: <%= t("conteos.toca_contar", cada: s.dias_conteo) %></p><% end %>
    <table class="w-full text-sm">
      <% @conteos.first(pieza.limite).each do |c| %>
        <tr class="border-t border-stone-100"><td class="py-1 font-mono"><%= c.folio %></td><td class="py-1"><%= c.sucursal %> · <%= c.responsable %></td><td class="py-1 text-right font-mono text-red-700"><%= pesos(c.faltante_centavos) %></td><td class="py-1 text-right font-mono text-green-700"><%= pesos(c.sobrante_centavos) %></td></tr>
      <% end %>
      <% if @conteos.empty? %><tr><td class="py-3 text-center text-stone-500"><%= t("inicio.sin_conteos") %></td></tr><% end %>
    </table>
  </div>
<% end %>
