<div class="card">
  <h2 class="mb-2 font-semibold"><%= t("inicio.cortes_cerrados") %></h2>
  <table class="w-full text-sm">
    <% @cortes.first(pieza.limite).each do |c| %>
      <tr class="border-t border-stone-100"><td class="py-1 font-mono"><%= c.folio %></td><td class="py-1"><%= c.sucursal %> · <%= c.usuario %></td><td class="py-1 text-right font-mono"><%= pesos(c.esperado_centavos) %></td><td class="py-1 text-right font-mono <%= c.diferencia_centavos.to_i.negative? ? 'text-red-700' : 'text-green-700' %>"><%= pesos(c.diferencia_centavos) %></td></tr>
    <% end %>
    <% if @cortes.empty? %><tr><td class="py-3 text-center text-stone-500"><%= t("inicio.sin_cortes") %></td></tr><% end %>
  </table>
</div>
