<%# Lives inside Settings, under the advanced options. %>
<div class="grid gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">
<%= render "settings/menu", current: "repl" %>
<section class="min-w-0">
<h2 class="mb-1 text-xl font-bold"><%= t("repl.title") %></h2>
<p class="mb-4 max-w-3xl text-sm text-stone-600"><%= t("repl.help") %> <%= link_to t("repl.view_log"), repl_log_path, class: "link" %></p>

<div class="grid gap-6 2xl:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="min-w-0 space-y-4">
    <%= form_with url: repl_evaluate_path, class: "form space-y-3", data: { turbo: false } do |f| %>
      <%= text_area_tag :text, @text, id: "text", rows: 4, spellcheck: false, autocomplete: "off", class: "code w-full px-3 py-2" %>
      <%= f.button class: "btn btn-primary" do %><i class="bi bi-play"></i> <%= t("repl.evaluate") %><% end %>
    <% end %>

    <% if @error %>
      <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900" id="error"><i class="bi bi-exclamation-triangle-fill"></i> <%= @error %></p>
    <% elsif @evaluated %>
      <div id="result">
        <% if repl_table?(@value) %>
          <p class="mb-2 text-xs text-stone-500"><%= t("repl.rows", count: [ @value.size, Repl::ROWS ].min) %><%= " · #{t("repl.cut", n: Repl::ROWS)}" if @value.size > Repl::ROWS %></p>
          <div class="overflow-x-auto">
            <table class="table">
              <% columns = repl_columns(@value) %>
              <thead><tr><% columns.each do |c| %><th class="font-mono">:<%= c %></th><% end %></tr></thead>
              <tbody>
                <% @value.first(Repl::ROWS).each do |row| %>
                  <tr><% columns.each do |c| %><td class="px-3 py-1.5 <%= 'text-right tabular-nums' if row[c].is_a?(Numeric) %>"><%= repl_cell(row[c]) %></td><% end %></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% elsif @value.is_a?(Hash) %>
          <table class="table">
            <tbody>
              <% @value.each do |k, v| %><tr><td class="px-3 py-1.5 font-mono"><%= repl_cell(k) %></td><td class="px-3 py-1.5 <%= 'text-right tabular-nums' if v.is_a?(Numeric) %>"><%= repl_cell(v) %></td></tr><% end %>
            </tbody>
          </table>
        <% else %>
          <pre class="code overflow-x-auto rounded-lg bg-white p-3 text-sm ring-1 ring-stone-200"><%= Lisp.to_text(@value) %></pre>
        <% end %>
      </div>
    <% end %>

    <% if @reports.any? %>
      <div id="reports">
        <h3 class="stat-label mb-1"><%= t("repl.reports") %></h3>
        <div class="flex flex-wrap gap-2">
          <% @reports.each do |report| %>
            <%= button_to report.title, repl_evaluate_path, params: { text: report.code }, form: { data: { turbo: false } }, class: "btn btn-secondary btn-sm", title: "#{report.plugin} · #{report.code}" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @history.any? %>
      <div>
        <h3 class="stat-label mb-1"><%= t("repl.history") %></h3>
        <ul class="space-y-0.5 text-sm">
          <% @history.each do |h| %><li><%= link_to h.truncate(140), repl_path(text: h), class: "code text-brand-800 hover:underline" %></li><% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <aside class="card space-y-4 text-sm">
    <h2 class="font-semibold"><%= t("dashboard.reference.title") %></h2>
    <div>
      <h3 class="stat-label mb-1"><%= t("repl.queries") %></h3>
      <ul class="space-y-0.5">
        <% Repl::QUERIES.each do |n| %><li><code class="code text-brand-800"><%= Repl::SIGNATURES[n] %></code> <span class="text-stone-500"><%= t("repl.functions.#{n.underscore}") %></span></li><% end %>
      </ul>
    </div>
    <div>
      <h3 class="stat-label mb-1"><%= t("repl.tools") %></h3>
      <ul class="space-y-0.5">
        <% Repl::TOOLS.each do |n| %><li><code class="code text-brand-800"><%= Repl::SIGNATURES[n] %></code> <span class="text-stone-500"><%= t("repl.functions.#{n.underscore}") %></span></li><% end %>
      </ul>
    </div>
    <div>
      <h3 class="stat-label mb-1"><%= t("rules.example") %></h3>
      <pre class="code mt-1 overflow-x-auto rounded-lg bg-stone-50 p-2 text-xs ring-1 ring-stone-200">(sum-of :total (sales (days-ago 7) (today)))
(sort-by-desc :balance (customers))
(count-by :cashier (sales))
(where :stopped true (reviews))
(take 5 (sort-by-desc :amount (sale-lines)))</pre>
    </div>
  </aside>
</div>
</section>
</div>
