<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("inventory.stock_levels") %> · <%= @branch %></h1>
  <%= render "branch_selector" %>
</div>
<table class="table">
  <thead><tr><th class="px-3 py-2"><%= t("common.key") %></th><th class="px-3 py-2"><%= t("common.product") %></th><th class="px-3 py-2 text-right"><%= t("common.quantity") %></th><% if @reserved.any? %><th class="px-3 py-2 text-right"><%= t("inventory.reserved") %></th><th class="px-3 py-2 text-right"><%= t("inventory.available") %></th><% end %><th class="px-3 py-2"><%= t("common.unit") %></th><th class="px-3 py-2"></th></tr></thead>
  <tbody>
    <% @stock_levels.each do |e| %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 font-mono"><%= e.product.key %></td>
        <td class="px-3 py-2"><%= e.product.name %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(e.quantity, precision: e.product.decimals, delimiter: ",") %></td>
        <% if @reserved.any? %>
          <% reserved = @reserved.fetch(e.product_id, 0) %>
          <td class="px-3 py-2 text-right font-mono text-stone-500"><%= number_with_precision(reserved, precision: e.product.decimals, delimiter: ",") if reserved.positive? %></td>
          <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(e.quantity - reserved, precision: e.product.decimals, delimiter: ",") %></td>
        <% end %>
        <td class="px-3 py-2"><%= e.product.unit %></td>
        <td class="px-3 py-2 text-right"><%= link_to t("inventory.kardex"), kardex_inventory_path(product_id: e.product_id, branch_id: @branch.id), class: "btn btn-secondary btn-xs" %></td>
      </tr>
    <% end %>
    <% if @stock_levels.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("inventory.no_stock_levels") %></td></tr><% end %>
  </tbody>
</table>
