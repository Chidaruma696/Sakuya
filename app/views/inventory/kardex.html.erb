<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("inventory.kardex") %> · <%= @branch %><%= " · #{@product.name}" if @product %></h1>
  <%= render "branch_selector" %>
</div>
<table class="table">
  <thead><tr><th class="px-3 py-2"><%= t("common.date") %></th><th class="px-3 py-2"><%= t("common.product") %></th><th class="px-3 py-2"><%= t("common.kind") %></th><th class="px-3 py-2 text-right"><%= t("common.quantity") %></th><th class="px-3 py-2 text-right"><%= t("common.balance") %></th><th class="px-3 py-2"><%= t("common.who") %></th><th class="px-3 py-2"><%= t("common.reason") %></th></tr></thead>
  <tbody>
    <% @movements.each do |m| %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 whitespace-nowrap"><%= l m.created_at, format: :short %></td>
        <td class="px-3 py-2"><%= m.product.name %></td>
        <td class="px-3 py-2"><%= m.kind_name %></td>
        <td class="px-3 py-2 text-right font-mono <%= m.inflow? ? 'text-green-700' : 'text-red-700' %>"><%= m.inflow? ? "+" : "−" %><%= number_with_precision(m.quantity, precision: m.product.decimals) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(m.balance, precision: m.product.decimals) %></td>
        <td class="px-3 py-2"><%= m.user.name %></td>
        <td class="px-3 py-2 text-stone-600"><%= m.reason %></td>
      </tr>
    <% end %>
    <% if @movements.empty? %><tr><td colspan="8" class="px-3 py-6 text-center text-stone-500"><%= t("inventory.no_movements") %></td></tr><% end %>
  </tbody>
</table>
