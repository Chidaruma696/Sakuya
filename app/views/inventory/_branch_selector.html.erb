<% if current_branch.head_office? || can?("admin.users") %>
  <%= form_with url: url_for, method: :get, class: "flex items-center gap-2 text-sm" do |f| %>
    <%= f.hidden_field :product_id, value: params[:product_id] if params[:product_id].present? %>
    <%= f.label :branch_id, t("common.branch") %>
    <%= f.select :branch_id, Branch.active.order(:name).pluck(:name, :id), { selected: @branch.id },
                 onchange: "this.form.requestSubmit()", class: "btn btn-secondary btn-xs" %>
  <% end %>
<% end %>
