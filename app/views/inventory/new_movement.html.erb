<h1 class="mb-4 text-2xl font-bold"><%= t("inventory.inflow_or_adjustment") %> · <%= @branch %></h1>
<%= form_with url: movements_inventory_path(branch_id: @branch.id), class: "form" do |f| %>
  <div class="fields-4">
    <div class="md:col-span-2">
      <%= f.label :product_id, t("common.product"), class: "field-label" %>
      <%= f.select :product_id, Product.active.order(:name).map { |p| [ "#{p.name} (#{p.unit})", p.id ] }, { selected: @movement.product_id }, class: "input" %>
    </div>
    <div>
      <%= f.label :kind, t("common.kind"), class: "field-label" %>
      <%= f.select :kind, %w[inflow adjustment_inflow adjustment_outflow waste].map { |x| [ t("movements.#{x}"), x ] }, { selected: @movement.kind }, class: "input" %>
    </div>
    <div>
      <%= f.label :quantity, t("common.quantity"), class: "field-label" %>
      <%= f.number_field :quantity, step: "0.001", min: "0.001", value: @movement.quantity, required: true, class: "input font-mono" %>
    </div>
    <div class="md:col-span-2 xl:col-span-4">
      <%= f.label :reason, t("common.reason"), class: "field-label" %>
      <%= f.text_field :reason, value: @movement.reason, required: true, class: "input" %>
    </div>
  </div>
  <% unless can?("inventory.adjust") || Rule.current("movement") %>
    <p class="text-xs text-stone-600"><%= t("inventory.remains_pending_review") %></p>
  <% end %>
  <%= f.submit t("inventory.register"), class: "btn btn-primary btn-lg" %>
<% end %>
