<% content_for :body_class, "items-stretch" %>
<%# Full-screen, step-by-step first-run setup: language, appearance, business, branch, folios, administrator, summary. %>
<div class="grid min-h-screen w-full grid-rows-[auto_1fr] lg:grid-cols-[340px_1fr] lg:grid-rows-1" data-controller="steps" data-steps-initial-value="<%= @step || 1 %>">
  <aside class="flex flex-col gap-5 bg-brand-700 px-6 py-6 text-light lg:px-8 lg:py-8">
    <div class="flex items-center gap-4 lg:flex-col lg:items-start">
      <%= image_tag "logo-w.png", alt: "Sakuya", class: "h-24 w-24 shrink-0 lg:h-56 lg:w-56" %>
      <div>
        <div class="text-3xl font-bold leading-tight">Sakuya</div>
        <div class="text-xs opacity-80">v<%= Sakuya::VERSION %> · <%= t("setup.title") %></div>
      </div>
    </div>
    <p class="text-sm opacity-90"><%= t("setup.intro") %></p>
    <ol class="flex flex-wrap gap-x-4 gap-y-1 text-sm lg:flex-col lg:gap-2">
      <% %w[language appearance business branch folios administrator summary].each_with_index do |step, i| %>
        <li class="flex items-center gap-2 underline-offset-4" data-steps-target="indicator">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-light/20 font-mono text-xs"><%= i + 1 %></span>
          <span><%= t("setup.steps.#{step}") %></span>
        </li>
      <% end %>
    </ol>
  </aside>

  <main class="flex flex-col justify-center px-6 py-8 sm:px-12 lg:px-20">
    <% if flash[:alert] %>
      <p class="mb-6 rounded bg-red-50 px-3 py-2 text-sm text-red-700"><%= flash[:alert] %></p>
    <% end %>
    <%= form_with url: install_path, scope: :setup, class: "flex flex-col", data: { turbo: false } do |f| %>
      <%= f.hidden_field :language, value: I18n.locale %>

      <%# 1. Language (changing it reloads the page: that is why it comes first, before typing anything) %>
      <section class="max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.welcome") %></h1>
        <p class="text-stone-600"><%= t("setup.language_help") %></p>
        <div class="grid gap-3 sm:grid-cols-3">
          <% { "es" => "Español", "en" => "English", "de" => "Deutsch" }.each do |i, name| %>
            <%= link_to install_path(language: i), class: "option #{'border-brand-600 bg-brand-50 text-brand-900' if I18n.locale.to_s == i}" do %>
              <%= name %> <% if I18n.locale.to_s == i %><i class="bi bi-check-circle-fill ml-auto text-brand-600"></i><% end %>
            <% end %>
          <% end %>
        </div>
        <p class="text-xs text-stone-500"><%= t("setup.language_note") %></p>
      </section>

      <%# 2. Appearance %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.appearance") %></h1>
        <p class="text-stone-600"><%= t("setup.appearance_help") %></p>
        <% icons = { "system" => "circle-half", "light" => "sun", "dark" => "moon-stars", "small" => "zoom-out", "normal" => "fonts", "large" => "zoom-in", "compact" => "arrows-collapse" } %>
        <% { theme: User::THEMES, text_size: User::TEXT_SIZES, density: User::DENSITIES }.each do |field, values| %>
          <fieldset>
            <legend class="mb-2 text-sm font-medium"><%= t("settings.#{field}") %></legend>
            <div class="grid gap-3 sm:grid-cols-3">
              <% values.each do |v| %>
                <label class="option">
                  <%= f.radio_button field, v, checked: @data[field].to_s == v, class: "sr-only", data: { attribute: (field == :theme ? "theme" : field), action: "change->steps#apply" } %>
                  <i class="bi bi-<%= field == :density && v == "normal" ? "arrows-expand" : icons[v] %> text-2xl text-stone-500"></i>
                  <%= t("settings.#{field}_options.#{v}") %>
                  <i class="bi bi-check-circle-fill option-check"></i>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% end %>
      </section>

      <%# 3. Business %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.business") %></h1>
        <div>
          <%= f.label :business, t("setup.business_name"), class: "field-label" %>
          <%= f.text_field :business, value: @data[:business], required: true, class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 text-lg" %>
          <p class="mt-1 text-xs text-stone-500"><%= t("setup.business_name_help") %></p>
        </div>
        <fieldset>
          <legend class="mb-2 text-sm font-medium"><%= t("setup.business_type") %></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <% Features::BUSINESS_TYPES.each_key do |g| %>
              <label class="option items-start text-base">
                <%= f.radio_button :business_type, g, checked: @data[:business_type].to_s == g, class: "mt-1" %>
                <span class="flex-1">
                  <strong><%= t("business_types.#{g}.name") %></strong>
                  <ul class="mt-2 space-y-1 text-xs">
                    <li class="flex items-center gap-2 text-stone-700"><i class="bi bi-check-circle-fill text-emerald-600"></i> <%= t("setup.always_includes") %></li>
                    <% Features::OPTIONAL.each do |m| %>
                      <% includes = Features::BUSINESS_TYPES[g].include?(m) %>
                      <li class="flex items-center gap-2 <%= includes ? 'text-stone-700' : 'text-stone-400 line-through' %>"><i class="bi <%= includes ? 'bi-check-circle-fill text-emerald-600' : 'bi-x-circle text-stone-300' %>"></i> <%= t("features.#{m}.name") %></li>
                    <% end %>
                  </ul>
                </span>
              </label>
            <% end %>
          </div>
          <p class="mt-2 text-xs text-stone-500"><%= t("setup.business_type_help") %></p>
        </fieldset>
      </section>

      <%# 4. Main branch %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.branch") %></h1>
        <p class="text-stone-600"><%= t("setup.head_office_help") %></p>
        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <%= f.label :branch, t("setup.head_office"), class: "field-label" %>
            <%= f.text_field :branch, value: @data[:branch], placeholder: t("setup.head_office_placeholder"), class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 text-lg" %>
          </div>
          <div>
            <%= f.label :code, t("common.code"), class: "field-label" %>
            <%= f.text_field :code, value: @data[:code], maxlength: 10, class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 font-mono text-lg uppercase" %>
          </div>
        </div>
      </section>

      <%# 5. Folios: how documents are numbered %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step" data-controller="folios-example">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.folios") %></h1>
        <p class="text-stone-600"><%= t("setup.folios.help") %></p>
        <fieldset>
          <legend class="mb-2 text-sm font-medium"><%= t("setup.folios.mode") %></legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <% Folio::MODES.each do |m| %>
              <label class="option items-start text-base">
                <%= f.radio_button :folios_mode, m, checked: @data[:folios_mode].to_s == m, class: "mt-1", data: { action: "folios-example#render" } %>
                <span class="flex-1"><strong><%= t("settings.folios.modes.#{m}") %></strong><br><span class="text-sm font-normal text-stone-600"><%= t("settings.folios.modes.#{m}_help") %></span></span>
                <i class="bi bi-check-circle-fill option-check text-2xl"></i>
              </label>
            <% end %>
          </div>
        </fieldset>
        <fieldset>
          <legend class="mb-2 text-sm font-medium"><%= t("setup.folios.prefix") %></legend>
          <div class="grid gap-3 sm:grid-cols-3">
            <% %w[branch own none].each do |l| %>
              <label class="option items-start text-base">
                <%= f.radio_button :folios_prefix, l, checked: @data[:folios_prefix].to_s == l, class: "mt-1", data: { action: "folios-example#render" } %>
                <span class="flex-1"><strong><%= t("setup.folios.prefixes.#{l}") %></strong><br><span class="text-sm font-normal text-stone-600"><%= t("setup.folios.prefixes.#{l}_help") %></span></span>
                <i class="bi bi-check-circle-fill option-check text-2xl"></i>
              </label>
            <% end %>
          </div>
        </fieldset>
        <div class="grid grid-cols-3 gap-3 items-end">
          <div data-folios-example-target="own">
            <%= f.label :folios_sale, t("setup.folios.sale"), class: "field-label" %>
            <%= f.text_field :folios_sale, value: @data[:folios_sale], maxlength: 4, pattern: "[A-Za-z0-9]{0,4}", class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 font-mono text-lg uppercase", data: { action: "input->folios-example#render" } %>
          </div>
          <p class="col-span-2 text-sm text-stone-600"><%= t("setup.folios.example") %> <strong class="stat-value text-lg" data-folios-example-target="example"></strong></p>
        </div>
        <p class="text-xs text-stone-500"><%= t("setup.folios.after") %></p>
      </section>

      <%# 6. Administrator %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.administrator") %></h1>
        <p class="text-stone-600"><%= t("setup.administrator_help") %></p>
        <div>
          <%= f.label :name, t("common.name"), class: "field-label" %>
          <%= f.text_field :name, value: @data[:name], required: true, autocomplete: "name", class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 text-lg" %>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <%= f.label :user, t("session.user"), class: "field-label" %>
            <%= f.text_field :user, value: @data[:user], required: true, autocomplete: "username", autocapitalize: "none", class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 text-lg" %>
          </div>
          <div>
            <%= f.label :password, t("session.password"), class: "field-label" %>
            <%= f.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "mt-1 w-full rounded border border-stone-300 px-3 py-3 text-lg" %>
            <p class="mt-1 text-xs text-stone-500"><%= t("setup.password_help") %></p>
          </div>
        </div>
      </section>

      <%# 7. Summary %>
      <section class="hidden max-w-2xl space-y-6" data-steps-target="step">
        <h1 class="text-3xl font-bold"><%= t("setup.steps.summary") %></h1>
        <p class="text-stone-600"><%= t("setup.summary_help") %></p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 rounded-lg border border-stone-200 bg-white p-4 text-sm" data-steps-target="summary">
          <dt class="text-stone-500"><%= t("setup.business_name") %></dt><dd data-field="business"></dd>
          <dt class="text-stone-500"><%= t("setup.business_type") %></dt><dd data-field="business_type"></dd>
          <dt class="text-stone-500"><%= t("setup.head_office") %></dt><dd data-field="branch" data-empty="<%= t("setup.head_office_placeholder") %>"></dd>
          <dt class="text-stone-500"><%= t("common.code") %></dt><dd class="font-mono" data-field="code" data-empty="MTZ"></dd>
          <dt class="text-stone-500"><%= t("setup.steps.folios") %></dt><dd data-field="folios_prefix"></dd>
          <dt class="text-stone-500"><%= t("setup.steps.administrator") %></dt><dd data-field="name"></dd>
          <dt class="text-stone-500"><%= t("session.user") %></dt><dd class="font-mono" data-field="user"></dd>
          <dt class="text-stone-500"><%= t("session.password") %></dt><dd data-field="password"></dd>
          <dt class="text-stone-500"><%= t("settings.language") %></dt><dd><%= t("settings.languages.#{I18n.locale}") %></dd>
        </dl>
      </section>

      <div class="mt-10 flex items-center gap-3">
        <button type="button" class="btn btn-secondary" data-steps-target="previous" data-action="steps#previous"><i class="bi bi-arrow-left"></i> <%= t("setup.previous") %></button>
        <button type="button" class="btn btn-primary btn-lg ml-auto" data-steps-target="next" data-action="steps#next"><%= t("setup.next_step") %> <i class="bi bi-arrow-right"></i></button>
        <%= f.submit t("setup.create"), class: "btn btn-success btn-lg ml-auto hidden", data: { steps_target: "send" } %>
      </div>
    <% end %>
  </main>
</div>
