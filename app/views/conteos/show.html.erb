<% c = @conteo %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("conteos.conteo") %> <%= c.folio %> · <%= c.sucursal %></h1>
  <span class="badge"><%= t("estados.#{c.estado}") %><%= " · #{t("conteos.parcial_badge", count: @lineas.size)}" if c.parcial? %></span>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("conteos.supervisor") %> <%= c.usuario %> · <%= t("conteos.responsable").downcase %> <%= c.responsable %> · <%= l c.created_at, format: :short %><%= " · #{t("estados.cerrado")} #{l c.cerrado_en, format: :short}" if c.cerrado_en %></p>
<% if c.abierto? %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("conteos.escanear") %></h2>
      <%= form_with url: escanear_conteo_path(c), class: "flex gap-2" do |f| %>
        <%= f.text_field :codigo, autofocus: true, autocomplete: "off", placeholder: t("conteos.codigo_placeholder"), class: "flex-1 rounded border border-stone-300 px-3 py-2 font-mono" %>
        <%= f.submit t("conteos.contar"), class: "btn btn-primary" %>
      <% end %>
      <p class="mt-2 text-sm text-stone-600"><%= t("conteos.escanear_ayuda") %></p>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("conteos.contar_a_mano") %></h2>
      <%= form_with url: manual_conteo_path(c), class: "flex gap-2" do |f| %>
        <%= f.select :producto_id, @productos.map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "flex-1 rounded border border-stone-300 px-2 py-2" %>
        <%= f.number_field :cantidad, step: "0.001", min: 0, required: true, class: "w-28 rounded border border-stone-300 px-2 py-2 font-mono" %>
        <%= f.submit t("comun.guardar"), class: "btn btn-primary" %>
      <% end %>
      <%= button_to t("conteos.cerrar"), cerrar_conteo_path(c), class: "mt-4 rounded bg-red-700 px-4 py-2 text-white", form: { data: { turbo_confirm: t("conteos.confirmar_cerrar", responsable: c.responsable) } } %>
    </div>
  </div>
<% else %>
  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("conteos.faltante") %></div><div class="font-mono text-2xl text-red-700"><%= pesos(c.faltante_centavos) %></div></div>
    <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("conteos.sobrante") %></div><div class="font-mono text-2xl text-green-700"><%= pesos(c.sobrante_centavos) %></div></div>
  </div>
<% end %>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2 text-right"><%= t("conteos.sistema") %></th><th class="px-3 py-2 text-right"><%= t("conteos.escaneado") %></th><th class="px-3 py-2 text-right"><%= t("conteos.a_mano") %></th><th class="px-3 py-2 text-right"><%= t("conteos.contado") %></th><th class="px-3 py-2 text-right"><%= t("caja.diferencia") %></th><th class="px-3 py-2 text-right">$</th></tr></thead>
  <tbody>
    <% @lineas.each do |l| %>
      <% dif = c.abierto? ? l.contado - l.sistema : l.diferencia %>
      <tr class="border-t border-stone-100 <%= 'bg-red-50' if dif.negative? %> <%= 'bg-green-50' if dif.positive? %>">
        <td class="px-3 py-2"><%= l.producto.nombre %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.sistema, precision: l.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.escaneado, precision: l.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.manual, precision: l.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.contado, precision: l.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(dif, precision: l.producto.decimales) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(l.diferencia_centavos) if l.diferencia_centavos %></td>
      </tr>
    <% end %>
  </tbody>
</table>
