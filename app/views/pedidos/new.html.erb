<h1 class="mb-1 text-2xl font-bold"><%= t("pedidos.nuevo") %></h1>
<p class="mb-4 text-sm text-stone-600"><%= t("pedidos.ayuda") %></p>
<%= form_with model: @pedido, url: pedidos_path, class: "formulario", data: { controller: "renglones", renglones_url_value: buscar_productos_path } do |f| %>
  <% if @pedido.errors.any? %><div class="rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800"><%= @pedido.errors.full_messages.join(". ") %></div><% end %>
  <div class="campos">
    <div>
      <%= f.label :cliente_id, t("caja.cliente"), class: "etiqueta-campo" %>
      <%= f.collection_select :cliente_id, @clientes, :id, :nombre, { include_blank: "—" }, required: true, class: "entrada" %>
      <% if @clientes.empty? %><p class="mt-1 text-xs text-amber-700"><%= link_to t("pedidos.primero_cliente"), new_cliente_path, class: "enlace" %></p><% end %>
    </div>
    <div><%= f.label :fecha_entrega, t("pedidos.entrega"), class: "etiqueta-campo" %><%= f.date_field :fecha_entrega, class: "entrada" %></div>
    <div><%= f.label :notas, t("comun.notas"), class: "etiqueta-campo" %><%= f.text_field :notas, class: "entrada" %></div>
  </div>
  <div class="rounded-lg border border-stone-200 p-4">
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <label class="text-sm font-medium" for="escaner"><%= icono("upc-scan", t("compras.escanear")) %></label>
      <input id="escaner" type="text" autocomplete="off" data-renglones-target="escaner" data-action="keydown->renglones#escanear" placeholder="<%= t("compras.escanear_ayuda") %>" class="entrada mt-0 max-w-md font-mono">
      <span data-renglones-target="aviso" class="text-sm text-amber-700"></span>
    </div>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="w-40 py-1"><%= t("comun.cantidad") %></th><th class="w-10"></th></tr></thead>
      <tbody data-renglones-target="cuerpo">
        <%= f.fields_for :lineas do |l| %>
          <tr data-renglones-target="fila">
            <td class="py-1 pr-2"><%= l.collection_select :producto_id, @productos, :id, ->(p) { "#{p.nombre} (#{p.unidad_corta})" }, { include_blank: "—" }, class: "entrada mt-0" %></td>
            <td class="py-1 pr-2"><%= l.number_field :cantidad, step: "0.001", min: "0.001", data: { campo: "cantidad" }, class: "entrada mt-0 font-mono" %></td>
            <td class="py-1"><button type="button" data-action="renglones#quitar" class="btn btn-ghost-danger btn-sm"><i class="bi bi-x-lg"></i></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="button" data-action="renglones#nuevo" class="btn btn-secondary mt-3">+ <%= t("comun.renglon") %></button>
  </div>
  <%= f.submit t("pedidos.guardar"), class: "btn btn-primary btn-lg" %>
<% end %>
