<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("pedidos.pedido", folio: @pedido.folio) %> <span class="badge"><%= t("pedidos.estados.#{@pedido.estado}") %></span>
    <% if @pedido.abierto? %><span class="badge"><%= t(@pedido.apartar ? "pedidos.apartado" : "pedidos.sin_apartar") %></span><% end %></h1>
  <%= link_to t("pedidos.titulo"), pedidos_path, class: "btn btn-ghost btn-sm" %>
</div>
<div class="mb-4 grid gap-4 sm:grid-cols-3">
  <div class="card"><div class="etiqueta-dato"><%= t("caja.cliente") %></div><div class="text-lg font-semibold"><%= link_to @pedido.cliente, cuenta_cliente_path(@pedido.cliente), class: "enlace" %></div></div>
  <div class="card"><div class="etiqueta-dato"><%= t("pedidos.entrega") %></div><div class="text-lg font-semibold"><%= @pedido.fecha_entrega ? l(@pedido.fecha_entrega) : "—" %></div></div>
  <div class="card"><div class="etiqueta-dato"><%= t("comun.notas") %></div><div><%= @pedido.notas.presence || "—" %></div></div>
</div>
<table class="tabla mb-6">
  <thead><tr><th><%= t("comun.producto") %></th><th class="text-right"><%= t("comun.cantidad") %></th></tr></thead>
  <tbody>
    <% @pedido.lineas.each do |l| %><tr><td class="px-3 py-2"><%= l.producto.nombre %></td><td class="px-3 py-2 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %> <%= l.producto.unidad_corta %></td></tr><% end %>
  </tbody>
</table>
<% if @pedido.abierto? %>
  <div class="flex flex-wrap items-end gap-4">
    <%= link_to icono("cart3", t("pedidos.cobrar")), caja_path(pedido: @pedido.id), class: "btn btn-success btn-lg" if puede?("caja.vender") %>
    <% if puede?("clientes.pedidos") %>
      <%= form_with url: cancelar_pedido_path(@pedido), class: "flex items-end gap-2 text-sm" do |f| %>
        <div><%= f.label :motivo, t("comun.motivo"), class: "etiqueta-campo" %><%= f.text_field :motivo, required: true, class: "entrada" %></div>
        <%= f.submit t("pedidos.cancelar"), class: "btn btn-danger" %>
      <% end %>
    <% end %>
  </div>
<% elsif @pedido.venta %>
  <p class="text-sm"><%= t("pedidos.cobrado_en") %> <%= link_to @pedido.venta.folio, caja_ticket_path(@pedido.venta), class: "enlace font-mono" %></p>
<% elsif @pedido.motivo_cancelacion %>
  <p class="text-sm text-stone-600"><%= t("pedidos.cancelado_por", motivo: @pedido.motivo_cancelacion) %></p>
<% end %>
