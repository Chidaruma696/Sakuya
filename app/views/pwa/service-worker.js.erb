// Sakuya's service worker: makes the app installable, serves static files (CSS, JS, fonts,
// icons) from the cache and lets the till open offline (the till page is cached every time it
// is opened with a network; without one the cached copy is served, and the till sells with the
// catalog on the device). Everything else needs the server: offline, /offline.html is shown.
// Browsers only allow service workers on HTTPS or on localhost.
// The cache name carries the commit: every new version gets a fresh cache and drops the old one on activation.
const CACHE = "sakuya-<%= Sakuya::COMMIT %>"
const OFFLINE = "/offline.html"

self.addEventListener("install", (event) => {
  event.waitUntil(caches.open(CACHE).then((c) => c.add(OFFLINE)).then(() => self.skipWaiting()))
})

self.addEventListener("activate", (event) => {
  event.waitUntil(caches.keys().then((keys) => Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k)))).then(() => self.clients.claim()))
})

self.addEventListener("fetch", (event) => {
  const { request } = event
  if (request.method !== "GET") return
  const url = new URL(request.url)
  // Fingerprinted assets: they never change, cache first.
  if (url.pathname.startsWith("/assets/") || /\.(png|ico|woff2?)$/.test(url.pathname)) {
    event.respondWith(caches.open(CACHE).then(async (c) => (await c.match(request)) || fetch(request).then((r) => { if (r.ok) c.put(request, r.clone()); return r })))
    return
  }
  // The till: network first and cache it; offline, the cached copy.
  if (url.pathname === "/till" && (request.mode === "navigate" || request.headers.get("Accept")?.includes("text/html"))) {
    event.respondWith(fetch(request).then((r) => {
      if (r.ok && !r.redirected && !url.search) { const copy = r.clone(); caches.open(CACHE).then((c) => c.put("/till", copy)) }
      return r
    }).catch(async () => (await caches.match("/till")) || caches.match(OFFLINE)))
    return
  }
  // Pages: always from the network; offline, the "no connection" page.
  if (request.mode === "navigate") {
    event.respondWith(fetch(request).catch(() => caches.match(OFFLINE)))
  }
})
