<h1 class="mb-1 text-2xl font-bold"><%= t("purchases.new_invoice") %></h1>
<p class="mb-4 text-sm text-stone-600"><%= t("purchases.invoice_help") %></p>
<%= form_with model: @invoice, url: invoices_path, scope: :invoice, class: "form", data: { controller: "rows", rows_url_value: search_products_path } do |f| %>
  <div class="fields">
    <div>
      <%= f.label :supplier_id, t("purchases.supplier"), class: "field-label" %>
      <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "—" }, required: true, class: "input" %>
    </div>
    <div><%= f.label :folio, t("purchases.supplier_folio"), class: "field-label" %><%= f.text_field :folio, required: true, class: "input font-mono", placeholder: t("purchases.supplier_folio_help") %></div>
    <div><%= f.label :date, t("common.date"), class: "field-label" %><%= f.date_field :date, required: true, class: "input" %></div>
    <div><%= f.label :due, t("purchases.due"), class: "field-label" %><%= f.date_field :due, class: "input" %><p class="mt-1 text-xs text-stone-500"><%= t("purchases.due_help") %></p></div>
    <div><%= f.label :amount, t("purchases.amount_no_rows"), class: "field-label" %><%= f.number_field :amount, step: "0.01", min: 0, class: "input font-mono" %><p class="mt-1 text-xs text-stone-500"><%= t("purchases.amount_no_rows_help") %></p></div>
    <div><%= f.label :concept, t("purchases.concept"), class: "field-label" %><%= f.text_field :concept, class: "input" %></div>
  </div>
  <div class="rounded-lg border border-stone-200 p-4">
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <label class="text-sm font-medium" for="scanner"><%= icon("upc-scan", t("purchases.scan")) %></label>
      <input id="scanner" type="text" autocomplete="off" data-rows-target="scanner" data-action="keydown->rows#scan" placeholder="<%= t("purchases.scan_help") %>" class="input mt-0 max-w-md font-mono">
      <span data-rows-target="notice" class="text-sm text-amber-700"></span>
    </div>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("common.product") %></th><th class="w-36 py-1"><%= t("common.quantity") %></th><th class="w-28 py-1"><%= t("purchases.boxes") %></th><th class="w-36 py-1"><%= t("purchases.purchase_price") %></th><th class="w-10"></th></tr></thead>
      <tbody data-rows-target="body">
        <%= f.fields_for :lines do |l| %>
          <tr data-rows-target="row">
            <td class="py-1 pr-2"><%= l.collection_select :product_id, @products, :id, ->(p) { "#{p.name} (#{p.short_unit})" }, { include_blank: "—" }, class: "input mt-0" %></td>
            <td class="py-1 pr-2"><%= l.number_field :quantity, step: "0.001", min: "0.001", data: { field: "quantity" }, class: "input mt-0 font-mono" %></td>
            <td class="py-1 pr-2"><%= l.number_field :boxes, min: 0, placeholder: "0", class: "input mt-0 font-mono" %></td>
            <td class="py-1 pr-2"><%= l.number_field :price, step: "0.01", min: "0.01", class: "input mt-0 font-mono" %></td>
            <td class="py-1"><button type="button" data-action="rows#remove" class="btn btn-ghost-danger btn-sm"><i class="bi bi-x-lg"></i></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="button" data-action="rows#new" class="btn btn-secondary mt-3">+ <%= t("common.row") %></button>
  </div>
  <% if @loose.any? %>
    <div class="rounded-lg border border-stone-200 p-4">
      <h2 class="mb-1 text-sm font-medium"><%= t("purchases.receipts_to_link") %></h2>
      <p class="mb-2 text-xs text-stone-500"><%= t("purchases.receipts_to_link_help") %></p>
      <div class="grid gap-1 text-sm sm:grid-cols-2 lg:grid-cols-3">
        <% @loose.each do |r| %>
          <label class="flex items-center gap-2"><%= check_box_tag "invoice[receipt_ids][]", r.id, false, id: "receipt_#{r.id}" %> <span class="font-mono"><%= r.folio %></span> · <%= r.supplier %> · <%= l r.date %><%= " · #{r.delivery_note}" if r.delivery_note.present? %></label>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @lock || Rule.current("invoice") %>
    <div>
      <%= f.label :reason, t("purchases.reason_excess"), class: "field-label" %>
      <%= f.text_field :reason, class: "input max-w-xl" %>
      <p class="mt-1 text-xs text-stone-500"><%= t("purchases.lock_notice") %></p>
    </div>
  <% end %>
  <%= f.submit t("purchases.register_invoice"), class: "btn btn-primary btn-lg" %>
<% end %>
