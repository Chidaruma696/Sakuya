<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("purchases.invoices") %></h1>
  <%= link_to icon("file-earmark-plus", t("purchases.new_invoice")), new_invoice_path, class: "btn btn-primary" if can?("purchases.invoice") %>
</div>
<%= form_with url: invoices_path, method: :get, class: "mb-4 flex flex-wrap items-center gap-2 text-sm", data: { turbo_frame: "_top" } do |f| %>
  <%= f.select :supplier_id, @suppliers.map { |p| [ p.name, p.id ] }, { include_blank: t("purchases.all_suppliers"), selected: params[:supplier_id] }, class: "input mt-0 max-w-xs", onchange: "this.form.requestSubmit()" %>
<% end %>
<table class="table">
  <thead><tr><th><%= t("common.folio") %></th><th><%= t("common.date") %></th><th><%= t("purchases.due") %></th><th><%= t("purchases.supplier") %></th><th class="text-right"><%= t("till.amount") %></th><th class="text-right"><%= t("purchases.paid") %></th><th class="text-right"><%= t("purchases.remaining") %></th><th><%= t("common.status") %></th><th><%= t("purchases.receipt") %></th></tr></thead>
  <tbody>
    <% @invoices.each do |x| %>
      <tr class="<%= 'text-stone-400 line-through' if x.cancelled? %>">
        <td class="px-3 py-2"><%= link_to x.folio, invoice_path(x), class: "chip-folio" %></td>
        <td class="px-3 py-2 whitespace-nowrap"><%= l x.date %></td>
        <td class="px-3 py-2 whitespace-nowrap <%= 'font-semibold text-red-700' if x.overdue? %>"><%= l x.due if x.due %></td>
        <td class="px-3 py-2"><%= x.supplier %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(x.amount_cents) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(x.paid_cents) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= format_money(x.remaining_cents) unless x.cancelled? %></td>
        <td class="px-3 py-2"><%= x.cancelled? ? t("purchases.statuses.cancelled") : (x.paid? ? t("purchases.statuses.paid") : (x.overdue? ? t("purchases.statuses.overdue") : t("purchases.statuses.open"))) %></td>
        <td class="px-3 py-2"><% unless x.cancelled? %><% rs = x.receipt_status %><span class="rounded px-2 py-0.5 text-xs font-semibold <%= { 'complete' => 'bg-green-100 text-green-800', 'partial' => 'bg-amber-100 text-amber-800', 'no_receipt' => 'bg-red-100 text-red-800' }[rs] %>"><%= t("purchases.receipt_status.#{rs}") %></span><% end %></td>
      </tr>
    <% end %>
    <% if @invoices.empty? %><tr><td colspan="9" class="px-3 py-6 text-center text-stone-500"><%= t("purchases.no_invoices") %></td></tr><% end %>
  </tbody>
</table>
