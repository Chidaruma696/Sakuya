<h1 class="mb-1 text-2xl font-bold"><%= t("reabasto.minimos_de", sucursal: @sucursal.nombre) %></h1>
<p class="mb-4 max-w-3xl text-sm text-stone-600"><%= t("reabasto.minimos_ayuda") %></p>
<%= form_with url: reabasto_minimos_path(sucursal_id: @sucursal.id), method: :patch, class: "formulario" do |f| %>
  <table class="tabla">
    <thead><tr><th><%= t("comun.producto") %></th><th class="text-right"><%= t("reabasto.hay") %></th><th class="w-36"><%= t("reabasto.minimo") %></th><th class="w-36"><%= t("reabasto.maximo") %></th></tr></thead>
    <tbody>
      <% @productos.each do |p| %>
        <% m = @minimos[p.id] %>
        <tr>
          <td class="px-3 py-1.5"><%= p.nombre %> <span class="text-xs text-stone-500"><%= p.unidad_corta %></span></td>
          <td class="px-3 py-1.5 text-right font-mono"><%= cantidad(@existencias.fetch(p.id, 0), p) %></td>
          <td class="px-3 py-1.5"><%= number_field_tag "minimos[#{p.id}][minimo]", m&.minimo&.to_s("F"), step: "0.001", min: 0, class: "entrada mt-0 font-mono" %></td>
          <td class="px-3 py-1.5"><%= number_field_tag "minimos[#{p.id}][maximo]", m&.maximo&.to_s("F"), step: "0.001", min: 0, class: "entrada mt-0 font-mono" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="flex gap-2">
    <%= f.submit t("comun.guardar"), class: "btn btn-primary btn-lg" %>
    <%= link_to t("comun.cancelar"), reabasto_path, class: "btn btn-ghost btn-lg" %>
  </div>
<% end %>
