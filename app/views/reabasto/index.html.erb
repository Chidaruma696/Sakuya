<h1 class="mb-1 text-2xl font-bold"><%= t("reabasto.titulo") %></h1>
<p class="mb-4 max-w-3xl text-sm text-stone-600"><%= t("reabasto.ayuda") %></p>
<div class="space-y-4">
  <% @sucursales.each do |s| %>
    <% sugerido = @sugeridos[s.id] %>
    <div class="card text-sm" id="sucursal_<%= s.id %>">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-semibold"><%= s.nombre %> <span class="badge"><%= t("reabasto.faltan", count: sugerido.size) %></span></h2>
        <div class="flex gap-2">
          <%= link_to t("reabasto.minimos"), reabasto_minimos_path(sucursal_id: s.id), class: "btn btn-secondary btn-sm" %>
          <%= link_to icono("boxes", t("reabasto.armar")), new_traspaso_path(destino: s.id, sugerido: 1), class: "btn btn-primary btn-sm" if sugerido.any? %>
        </div>
      </div>
      <% if sugerido.any? %>
        <p class="mt-2 text-stone-700"><%= sugerido.map { |p, c| "#{cantidad(c, p)} #{p.unidad_corta} #{p.nombre}" }.join(" · ") %></p>
      <% end %>
    </div>
  <% end %>
</div>
