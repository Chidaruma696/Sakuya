<% x = @traspaso %>
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("traspasos.traspaso") %> <span class="font-mono"><%= x.folio %></span><%= tag.span(" · #{t("traspasos.estados.cancelado")}", class: "text-red-700") if x.cancelado? %></h1>
  <%= link_to icono("arrow-left", t("traspasos.titulo")), traspasos_path, class: "btn btn-ghost btn-sm" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= x.sucursal_origen %> → <%= x.sucursal_destino %> · <%= l x.fecha %> · <%= x.usuario %><%= " · #{x.notas}" if x.notas.present? %><%= " · #{x.motivo_cancelacion}" if x.cancelado? %></p>
<div class="grid gap-4 lg:grid-cols-3">
  <div class="card lg:col-span-2">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="py-1 text-right"><%= t("comun.cantidad") %></th><th class="py-1 text-right"><%= t("compras.cajas") %></th></tr></thead>
      <tbody>
        <% x.lineas.each do |l| %>
          <tr class="border-t border-stone-100"><td class="py-1"><%= l.producto.nombre %></td><td class="py-1 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td><td class="py-1 text-right font-mono"><%= l.cajas unless l.cajas.zero? %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if x.registrado? %>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("traspasos.cancelar") %></h2>
      <p class="mb-2 text-xs text-stone-500"><%= t("traspasos.cancelar_ayuda") %></p>
      <%= form_with url: cancelar_traspaso_path(x), class: "flex flex-wrap gap-2 text-sm", data: { turbo_confirm: t("compras.confirmar_cancelar", folio: x.folio) } do |f| %>
        <%= f.text_field :motivo, placeholder: t("comun.motivo").downcase, required: true, class: "entrada mt-0 flex-1" %>
        <%= f.submit t("comun.cancelar"), class: "btn btn-ghost-danger btn-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
