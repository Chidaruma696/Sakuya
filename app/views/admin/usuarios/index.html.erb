<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("admin.usuarios") %></h1>
  <%= link_to t("admin.nuevo_usuario"), new_admin_usuario_path, class: "btn btn-primary btn-sm" %>
</div>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.nombre") %></th><th class="px-3 py-2"><%= t("admin.usuario") %></th><th class="px-3 py-2"><%= t("admin.rol") %></th><th class="px-3 py-2"><%= t("comun.sucursal") %></th><th class="px-3 py-2"><%= t("comun.activo") %></th><th></th></tr></thead>
  <tbody>
    <% @usuarios.each do |u| %>
      <tr class="border-t border-stone-100 <%= 'text-stone-400' unless u.activo %>">
        <td class="px-3 py-2"><%= u.nombre %></td><td class="px-3 py-2 font-mono"><%= u.usuario %></td><td class="px-3 py-2"><%= u.rol %></td><td class="px-3 py-2"><%= u.sucursal %></td>
        <td class="px-3 py-2"><%= u.activo ? t("comun.si") : t("comun.no") %></td>
        <td class="px-3 py-2 text-right"><%= link_to t("comun.editar"), edit_admin_usuario_path(u), class: "btn btn-secondary btn-xs" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
