<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("admin.roles") %></h1>
  <%= link_to t("admin.nuevo_rol"), new_admin_rol_path, class: "btn btn-primary btn-sm" %>
</div>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("admin.rol") %></th><th class="px-3 py-2"><%= t("admin.permisos") %></th><th class="px-3 py-2"><%= t("admin.usuarios") %></th><th></th></tr></thead>
  <tbody>
    <% @roles.each do |r| %>
      <tr class="border-t border-stone-100 align-top">
        <td class="px-3 py-2 font-semibold"><%= r.nombre %></td>
        <td class="px-3 py-2 font-mono text-xs"><%= r.permisos.join(", ") %></td>
        <td class="px-3 py-2"><%= r.usuarios.size %></td>
        <td class="px-3 py-2 text-right"><%= link_to t("comun.editar"), edit_admin_rol_path(r), class: "btn btn-secondary btn-xs" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
