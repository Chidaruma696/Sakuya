<%= form_with model: [ :admin, @role ], class: "form" do |f| %>
  <%= render "admin/field", f: f, field: :name, label: t("common.name"), kind: :text_field %>
  <%= hidden_field_tag "role[permissions][]", "" %>
  <label class="flex items-center gap-2 text-sm font-semibold"><%= check_box_tag "role[permissions][]", "*", @role.permissions.include?("*"), id: "permission_all" %> <%= t("admin.all_administrator") %></label>
  <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
  <% Permission::KEYS.keys.select { |c| Features.permission_active?(c) }.group_by { |key| key.split(".").first }.each do |feature, keys| %>
    <fieldset class="rounded-lg border border-stone-200 p-4">
      <legend class="px-1 text-sm font-semibold"><%= t("admin.features.#{feature}", default: feature) %> <label class="ml-2 font-normal text-stone-500"><%= check_box_tag "role[permissions][]", "#{feature}.*", @role.permissions.include?("#{feature}.*"), id: "permission_#{feature}_all" %> <%= t("admin.all_feature") %></label></legend>
      <div class="grid gap-1">
        <% keys.each do |key| %>
          <label class="flex items-center gap-2 text-sm"><%= check_box_tag "role[permissions][]", key, @role.permissions.include?(key), id: "permission_#{key.tr('.', '_')}" %> <%= Permission.name(key) %> <span class="font-mono text-xs text-stone-400"><%= key %></span></label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  </div>
  <%= f.submit @role.new_record? ? t("common.create") : t("common.save"), class: "btn btn-primary btn-lg" %>
<% end %>
