<h1 class="mb-4 text-2xl font-bold"><%= @producto.nombre %></h1>
<div class="grid gap-6 lg:grid-cols-2">
  <%= render "form" %>
  <div class="space-y-6">
  <div class="card p-6">
    <h2 class="mb-2 font-semibold"><%= t("admin.precio_por_sucursal") %></h2>
    <p class="mb-2 text-sm text-stone-600"><%= t("admin.precio_por_sucursal_ayuda", precio: pesos(@producto.precio_centavos), boton: t("comun.guardar")) %></p>
    <table class="w-full text-sm">
      <% Sucursal.activas.order(:nombre).each do |s| %>
        <% fijo = @producto.precios_sucursal.find { |ps| ps.sucursal_id == s.id } %>
        <tr class="border-t border-stone-100"><td class="py-1"><%= s.nombre %></td>
          <td class="py-1 text-right"><input type="number" step="0.01" min="0" name="precios[<%= s.id %>]" form="form_producto" value="<%= fijo ? (fijo.precio_centavos / 100.0) : '' %>" placeholder="<%= t("admin.general") %>" class="w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono"></td></tr>
      <% end %>
    </table>
  </div>
  <div class="card p-6">
    <h2 class="mb-2 font-semibold"><%= t("admin.codigos_proveedor") %></h2>
    <ul class="mb-3 text-sm">
      <% @producto.codigos_barras.each do |c| %>
        <li class="flex items-center justify-between border-t border-stone-100 py-1"><span class="font-mono"><%= c.codigo %></span> <%= button_to t("comun.quitar"), admin_producto_codigo_path(@producto, c), method: :delete, class: "text-red-700" %></li>
      <% end %>
    </ul>
    <%= form_with url: admin_producto_codigos_path(@producto), class: "flex gap-2" do |f| %>
      <%= f.text_field :codigo, placeholder: t("admin.escanea_o_teclea_codigo"), autocomplete: "off", class: "flex-1 rounded border border-stone-300 px-3 py-2 font-mono" %>
      <%= f.submit t("comun.agregar"), class: "btn btn-primary" %>
    <% end %>
  </div>
  </div>
</div>
