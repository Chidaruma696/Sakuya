<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("admin.sucursales") %></h1>
  <%= link_to t("admin.nueva_sucursal"), new_admin_sucursal_path, class: "btn btn-primary btn-sm" %>
</div>
<table class="tabla">
  <thead><tr><th class="px-3 py-2"><%= t("comun.codigo") %></th><th class="px-3 py-2"><%= t("comun.nombre") %></th><th class="px-3 py-2"><%= t("comun.tipo") %></th><th class="px-3 py-2 text-right"><%= t("admin.limite_en_gaveta") %></th><th class="px-3 py-2"><%= t("admin.activa") %></th><th></th></tr></thead>
  <tbody>
    <% @sucursales.each do |s| %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 font-mono"><%= s.codigo %></td><td class="px-3 py-2"><%= s.nombre %></td><td class="px-3 py-2"><%= s.matriz? ? t("comun.matriz") : (s.almacen? ? t("admin.almacen_corto") : t("admin.tienda")) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(s.limite_efectivo_centavos) %></td><td class="px-3 py-2"><%= s.activa ? t("comun.si") : t("comun.no") %></td>
        <td class="px-3 py-2 text-right"><%= link_to t("comun.editar"), edit_admin_sucursal_path(s), class: "btn btn-secondary btn-xs" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
