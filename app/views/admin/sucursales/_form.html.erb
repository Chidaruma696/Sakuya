<%= form_with model: [ :admin, @sucursal ], class: "formulario" do |f| %>
  <div class="campos-4">
    <%= render "admin/campo", f: f, campo: :codigo, etiqueta: t("comun.codigo"), tipo: :text_field %>
    <div><%= f.label :tipo, t("comun.tipo"), class: "etiqueta-campo" %><%= f.select :tipo, [ [ t("comun.matriz"), "matriz" ], [ t("admin.tienda"), "tienda" ] ] + (Modulo.activo?("almacenes") || @sucursal.almacen? ? [ [ t("admin.almacen"), "almacen" ] ] : []), {}, class: "entrada" %></div>
    <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("comun.nombre"), tipo: :text_field %>
    <%= render "admin/campo", f: f, campo: :limite_efectivo, etiqueta: t("admin.limite_efectivo"), tipo: :number_field, opciones: { step: "0.01", min: 1 } %>
    <div><%= f.label :impresora, t("admin.impresora"), class: "etiqueta-campo" %><%= f.select :impresora, Sucursal::IMPRESORAS.map { |i| [ t("admin.impresoras.#{i}"), i ] }, {}, class: "entrada" %></div>
    <div><%= f.label :impresora_red, t("admin.impresora_red"), class: "etiqueta-campo" %><%= f.text_field :impresora_red, placeholder: "192.168.1.50:9100", class: "entrada font-mono" %><p class="mt-1 text-xs text-stone-500"><%= t("admin.impresora_ayuda") %></p></div>
    <% if Modulo.activo?("conteos") %>
      <%= render "admin/campo", f: f, campo: :dias_conteo, etiqueta: t("admin.dias_conteo"), tipo: :number_field, opciones: { step: "1", min: 1 } %>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-4">
    <%= f.submit @sucursal.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary btn-lg" %>
    <label class="flex items-center gap-2 text-sm"><%= f.check_box :activa %> <%= t("admin.activa") %></label>
  </div>
<% end %>
