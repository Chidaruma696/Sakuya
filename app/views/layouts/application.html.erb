<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= current_user&.theme || "light" %>" data-density="<%= current_user&.density || "normal" %>" data-text-size="<%= current_user&.text_size || "normal" %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Sakuya" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#7a90d2">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sakuya">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# The icon: blue when the browser is light, light when it is dark %>
    <link rel="icon" href="/icon-b.png" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/icon-w.png" type="image/png" media="(prefers-color-scheme: dark)">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script>window.T = <%= raw I18n.t("js", locale: :en).deep_merge(I18n.t("js")).to_json %>; window.CURRENCY = <%= raw({ symbol: Setting.symbol, code: Setting["business.currency"] }.to_json) %>;</script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-surface text-stone-900" data-controller="dialog sidebar pwa">
    <%= render "layouts/ribbon" %>
    <%= render "layouts/about" %>
    <%# Notices as floating toasts: visible wherever you are on the page, and they close by themselves %>
    <% if flash[:notice] || flash[:alert] %>
      <div class="pointer-events-none fixed inset-x-0 top-3 z-50 flex flex-col items-center gap-2 px-4 sm:items-end" data-controller="notice">
        <% if flash[:notice] %><p class="pointer-events-auto flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-900 shadow-lg" data-notice-target="notice"><i class="bi bi-check-circle-fill text-green-600"></i> <%= flash[:notice] %> <button type="button" class="ml-2 text-green-700 hover:text-green-900" data-action="notice#close" title="<%= t("common.close") %>"><i class="bi bi-x-lg"></i></button></p><% end %>
        <% if flash[:alert] %><p class="pointer-events-auto flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-900 shadow-lg" data-notice-target="notice"><i class="bi bi-exclamation-triangle-fill text-accent-700"></i> <%= flash[:alert] %> <button type="button" class="ml-2 text-red-700 hover:text-red-900" data-action="notice#close" title="<%= t("common.close") %>"><i class="bi bi-x-lg"></i></button></p><% end %>
      </div>
    <% end %>
    <main class="w-full px-4 py-5 xl:px-8">
      <%= yield %>
    </main>
  </body>
</html>
