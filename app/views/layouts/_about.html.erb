<%# About: version, which commit it was built from, who is signed in, credits and where to report issues. %>
<dialog class="m-auto w-full max-w-md rounded-xl p-0 shadow-2xl" data-dialog-target="dialog" data-action="click->dialog#closeOutside">
  <div class="flex items-center gap-4 border-b border-stone-200 px-6 py-5">
    <%= image_tag "logo-b.png", alt: "Sakuya", class: "h-14 w-14" %>
    <div class="min-w-0 flex-1">
      <div class="text-xl font-bold tracking-tight">Sakuya</div>
      <div class="text-sm text-stone-600"><%= t("about.tagline") %></div>
    </div>
    <button type="button" class="btn btn-ghost btn-sm" data-action="dialog#close" title="<%= t("common.close") %>"><i class="bi bi-x-lg"></i></button>
  </div>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 px-6 py-4 text-sm">
    <dt class="text-stone-500"><%= t("about.version") %></dt><dd class="font-mono"><%= Sakuya::VERSION %> <span class="text-stone-500">· build <%= Sakuya::COMMIT %><%= " · #{l Date.parse(Sakuya::COMMIT_DATE), format: :long}" if Sakuya::COMMIT_DATE %></span></dd>
    <dt class="text-stone-500"><%= t("about.engine") %></dt><dd class="font-mono">Rails <%= Rails.version %> · Ruby <%= RUBY_VERSION %> · <%= ActiveRecord::Base.connection.adapter_name %></dd>
    <% if current_user %>
      <dt class="text-stone-500"><%= t("about.session") %></dt><dd><%= current_user %> · <%= current_user.role %> · <%= current_branch %><%= " (#{t('common.head_office')})" if current_branch&.head_office? %></dd>
      <dt class="text-stone-500"><%= t("about.server") %></dt><dd class="font-mono"><%= request.host_with_port %> · <%= Rails.env %></dd>
    <% end %>
  </dl>
  <div class="border-t border-stone-200 bg-stone-50 px-6 py-4 text-xs leading-relaxed text-stone-600">
    <p><%= t("about.credits_html") %></p>
    <p class="mt-1"><%= t("about.technology") %></p>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-2 border-t border-stone-200 px-6 py-3">
    <button type="button" class="btn btn-secondary btn-sm hidden" data-pwa-target="button" data-action="pwa#install"><i class="bi bi-download"></i> <%= t("about.install") %></button>
    <%= link_to t("about.code"), "https://github.com/Chidaruma696/Sakuya", target: "_blank", rel: "noopener", class: "btn btn-secondary btn-sm" %>
    <%= link_to t("about.report"), "https://github.com/Chidaruma696/Sakuya/issues/new", target: "_blank", rel: "noopener", class: "btn btn-secondary btn-sm" %>
    <button type="button" class="btn btn-primary btn-sm" data-action="dialog#close"><%= t("common.close") %></button>
  </div>
</dialog>
