<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= @venta&.folio || @titulo %></title>
    <style>
      /* Ticket térmico: puro negro (los grises se ven sucios), letra chica y densa, ancho según el
         papel (80 mm → 72 imprimibles, 58 → 48). */
      @page { size: <%= Ajuste.entero("ticket.ancho") == 58 ? 58 : 80 %>mm auto; margin: 2mm; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: "DejaVu Sans", Arial, sans-serif; font-size: 8pt; color: #000; }
      .ticket { width: <%= Ajuste.ancho_ticket_mm %>mm; padding: 2mm; }
      .centro { text-align: center; }
      .der { text-align: right; white-space: nowrap; }
      .neg { font-weight: bold; }
      .mono { font-family: "DejaVu Sans Mono", monospace; }
      .cursiva { font-style: italic; }
      .oculto { display: none; }
      .logo { text-align: center; margin-bottom: 1.5mm; }
      .logo img { max-width: 30mm; max-height: 20mm; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 0.5mm 0.6mm; vertical-align: top; }
      th:first-child, td:first-child { padding-left: 0; }
      th:last-child, td:last-child { padding-right: 0; }
      th { font-size: 7.5pt; border-bottom: 1px solid #000; text-align: left; }
      .linea { border-top: 1px solid #000; margin: 1.5mm 0; }
      .linea-punteada { border-top: 1px dashed #000; margin: 1.5mm 0; }
      .total { font-size: 11.5pt; }
      .tanto { text-align: center; font-weight: bold; border: 1px solid #000; padding: 0.6mm 1mm; margin: 1mm 0; }
      .cancelado { color: #000; font-weight: bold; font-size: 16pt; text-align: center; margin: 2mm 0; letter-spacing: 2px; }
      .recuadro { border: 1px dashed #000; padding: 1.2mm 1.6mm; margin: 1.5mm 0; }
      svg { width: 100%; height: auto; }
      /* Hojas de trabajo: letra un punto más grande que el ticket. */
      .hoja { font-size: 9.5pt; }
      .hoja th { font-size: 9pt; }
      /* En pantalla el papel se ve al doble y centrado; al imprimir sale a su tamaño real. */
      @media screen {
        body { background: #e7e5e4; padding: 24px 16px 48px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
        .ticket { background: white; box-shadow: 0 2px 12px rgba(0,0,0,.18); zoom: 1.9; }
        .acciones { display: flex; gap: 10px; font-family: system-ui, sans-serif; }
        .acciones button, .acciones a { font: 600 15px/1 system-ui, sans-serif; padding: 10px 18px; border-radius: 8px; border: 1px solid #4659a8; background: #4659a8; color: white; text-decoration: none; cursor: pointer; }
        .acciones a { background: white; color: #4659a8; }
      }
      /* Dentro del diseñador el zoom lo manejan los botones de la página, no este layout. */
      @media screen { body.previa { padding: 12px; gap: 0; } body.previa .ticket { zoom: 1; } body.previa .acciones { display: none; } }
      @media print { .acciones { display: none; } }
    </style>
  </head>
  <body class="<%= "previa" if @previa %>">
    <%= yield %>
    <div class="acciones" <%= "hidden" if @previa %>>
      <button onclick="window.print()"><%= t("comun.imprimir") %></button>
      <% if @venta&.persisted? %>
        <% if @venta.sucursal.impresora != "navegador" %><button type="button" id="termica"><%= t("caja.imprimir_termica") %></button><% end %>
        <a href="<%= caja_escpos_path(@venta, bajar: 1) %>" title="<%= t("caja.escpos_ayuda") %>"><%= t("caja.bajar_escpos") %></a>
        <a href="<%= caja_path %>"><%= t("caja.nueva_venta") %></a>
      <% end %>
    </div>
    <% if @venta&.persisted? && @venta.sucursal.impresora != "navegador" %>
      <p id="estado_impresion" class="acciones" style="font: 14px system-ui, sans-serif;"></p>
      <%# La térmica: por red la manda el servidor; por cable, el navegador con Web Serial. La primera
          vez por cable hay que elegir el puerto con un clic; luego el navegador lo recuerda. %>
      <script>
        (() => {
          const modo = <%= raw @venta.sucursal.impresora.to_json %>
          const estado = document.getElementById("estado_impresion")
          const textos = <%= raw({ impreso: t("caja.impreso"), sin_serial: t("caja.sin_serial"), elige: t("caja.elige_impresora") }.to_json) %>
          const porRed = async () => {
            const r = await fetch(<%= raw caja_imprimir_path(@venta).to_json %>, { method: "POST", headers: { Accept: "application/json", "X-CSRF-Token": <%= raw form_authenticity_token.to_json %> } })
            const datos = await r.json()
            estado.textContent = datos.aviso || datos.error
          }
          const porCable = async (elegir) => {
            if (!("serial" in navigator)) { estado.textContent = textos.sin_serial; return }
            let [puerto] = await navigator.serial.getPorts()
            if (!puerto) {
              if (!elegir) { estado.textContent = textos.elige; return }
              puerto = await navigator.serial.requestPort()
            }
            const bytes = new Uint8Array(await (await fetch(<%= raw caja_escpos_path(@venta).to_json %>)).arrayBuffer())
            await puerto.open({ baudRate: 9600 })
            const escritor = puerto.writable.getWriter()
            await escritor.write(bytes)
            escritor.releaseLock()
            await puerto.close()
            estado.textContent = textos.impreso
          }
          const imprimir = (elegir) => (modo === "red" ? porRed() : porCable(elegir)).catch((e) => { estado.textContent = e.message })
          document.getElementById("termica").addEventListener("click", () => imprimir(true))
          <% if params[:imprimir] %>window.addEventListener("load", () => imprimir(false))<% end %>
        })()
      </script>
    <% elsif params[:imprimir] %><script>window.addEventListener("load", () => window.print());</script><% end %>
  </body>
</html>
