<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("stock_transfers.title") %></h1>
  <%= link_to icon("boxes", t("stock_transfers.new")), new_stock_transfer_path, class: "btn btn-primary" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("stock_transfers.help") %></p>
<table class="table">
  <thead><tr><th><%= t("common.folio") %></th><th><%= t("common.date") %></th><th><%= t("stock_transfers.from") %></th><th><%= t("stock_transfers.a") %></th><th class="text-right"><%= t("purchases.rows") %></th><th><%= t("common.who") %></th><th><%= t("common.status") %></th></tr></thead>
  <tbody>
    <% @stock_transfers.each do |x| %>
      <tr class="<%= 'text-stone-400 line-through' if x.cancelled? %>">
        <td class="px-3 py-2"><%= link_to x.folio, stock_transfer_path(x), class: "chip-folio" %></td>
        <td class="px-3 py-2 whitespace-nowrap"><%= l x.date %></td>
        <td class="px-3 py-2"><%= x.origin_branch %></td><td class="px-3 py-2"><%= x.destination_branch %></td>
        <td class="px-3 py-2 text-right font-mono"><%= x.lines.size %></td>
        <td class="px-3 py-2"><%= x.user %></td>
        <td class="px-3 py-2"><%= t("stock_transfers.statuses.#{x.status}") %></td>
      </tr>
    <% end %>
    <% if @stock_transfers.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("stock_transfers.none") %></td></tr><% end %>
  </tbody>
</table>
