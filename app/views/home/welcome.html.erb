<h1 class="text-2xl font-bold">Sakuya</h1>
<p class="mt-2 text-stone-600"><%= t("common.branch") %> <strong><%= current_branch %></strong> · <%= current_user.role %></p>
<%= render "pending_review" %>
<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  <% Permission::KEYS.each_key do |key| %>
    <% next unless can?(key) && Features.permission_active?(key) %>
    <li class="rounded border border-stone-200 bg-white px-4 py-3 text-sm"><%= Permission.name(key) %> <span class="text-stone-400">(<%= key %>)</span></li>
  <% end %>
</ul>
