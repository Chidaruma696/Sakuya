<div class="mx-auto mt-6 max-w-2xl rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-stone-200">
  <i class="bi bi-cash-stack text-5xl text-brand-600"></i>
  <p class="mt-3 text-xl font-semibold"><%= t("till.no_till_in", branch: current_branch) %></p>
  <% if can?("till.open") %>
    <%= form_with url: till_open_path, class: "mx-auto mt-5 flex max-w-sm flex-col items-stretch gap-3" do |f| %>
      <%= f.label :float, t("till.initial_float"), class: "text-left text-sm font-medium" %>
      <%= f.number_field :float, step: "0.01", min: 0, value: "0.00", required: true, class: "input mt-0 text-center font-mono text-2xl" %>
      <%= f.submit t("till.open_till"), class: "btn btn-primary btn-lg" %>
    <% end %>
  <% else %>
    <p class="mt-2 text-stone-600"><%= t("till.ask_to_open_it") %></p>
  <% end %>
</div>
