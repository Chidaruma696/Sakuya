<%# The sale ticket. `sale` can be real or the sample from Settings › Ticket; the data-ticket
    attributes let the preview update while typing. The blocks come in the order of the layout
    (TicketLayout); in the designer every block is there, even the hidden ones, to bring them back. %>
<% settings = Setting.to_h %>
<% designing = @preview.present? %>
<% labels = TicketLayout.labels %>
<% label = ->(key) { tag.span(labels[key], data: { label_key: key, default: TicketLayout.default_label(key) }) } %>
<% other_branch = settings["business.name"].present? && sale.branch && sale.branch.name != settings["business.name"] %>
<div class="ticket" style="width: <%= Setting.ticket_width_mm %>mm" data-ticket="paper">
  <% TicketLayout.current.each do |block| %>
    <% next if block.off && !designing %>
    <div class="<%= block.css %>" data-block="<%= block.key %>" data-label="<%= t("settings.ticket.blocks.#{block.key}") %>" data-can="<%= TicketLayout::BLOCKS.fetch(block.key).last.join(" ") %>">
      <% case block.key %>
      <% when "logo" %>
        <div class="logo <%= 'hidden' if settings["ticket.logo"].blank? %>" data-ticket="logo"><img src="<%= settings["ticket.logo"].presence || "data:," %>" alt="" draggable="false"></div>
      <% when "name" %>
        <div data-ticket="business.name" data-empty="<%= sale.branch&.name %>"><%= settings["business.name"].presence || sale.branch&.name %></div>
      <% when "tagline" %>
        <div class="<%= 'hidden' if settings["ticket.tagline"].blank? %>" data-ticket="ticket.tagline"><%= settings["ticket.tagline"] %></div>
      <% when "branch" %>
        <% if other_branch || designing %><div class="<%= 'hidden' unless other_branch %>" data-ticket="branch"><%= sale.branch&.name %></div><% end %>
      <% when "address" %>
        <div class="<%= 'hidden' if settings["business.address"].blank? %>" data-ticket="business.address"><%= settings["business.address"] %></div>
      <% when "phone" %>
        <div class="<%= 'hidden' if settings["business.phone"].blank? %>" data-ticket="business.phone"><%= settings["business.phone"] %></div>
      <% when "tax_id" %>
        <div class="<%= 'hidden' if settings["ticket.tax_id"].blank? %>" data-ticket="ticket.tax_id"><%= settings["ticket.tax_id"] %></div>
      <% when "info" %>
        <div class="line"></div>
        <table>
          <tr>
            <td><%= label.("date") %>: <%= l sale.created_at, format: :short %><br><span class="bold"><%= label.("folio") %>: <%= sale.folio %></span></td>
            <td class="right <%= 'hidden' if settings["ticket.show_cashier"] != "1" %>" data-ticket="ticket.show_cashier"><%= label.("served_by") %><br><span class="bold"><%= sale.user&.name %></span></td>
          </tr>
        </table>
      <% when "lines" %>
        <table style="margin-top: 1mm;">
          <thead><tr><th style="width: 46%;"><%= label.("product") %></th><th class="right" style="width: 20%;"><%= label.("quantity") %></th><th class="right" style="width: 16%;"><%= label.("price") %></th><th class="right" style="width: 18%;"><%= label.("line_amount") %></th></tr></thead>
          <tbody>
            <% sale.lines.each do |l| %>
              <tr>
                <td><%= l.product.name %><%= " (#{l.promotion.name})" if l.promotion %><%= " *" if l.price_cents < l.catalog_cents %></td>
                <td class="right mono"><%= quantity(l.quantity, l.product) %></td>
                <td class="right mono"><%= format_money(l.price_cents) %></td>
                <td class="right mono"><%= format_money(l.amount_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% when "totals" %>
        <div class="line"></div>
        <table>
          <tr><td class="bold total"><%= label.("total") %></td><td class="right bold mono total"><%= format_money(sale.total_cents) %></td></tr>
          <% sale.payments.each do |p| %><tr><td><%= t("payment_methods.#{p.payment_method}") %></td><td class="right mono"><%= format_money(p.amount_cents) %></td></tr><% end %>
          <tr><td><%= label.("change") %></td><td class="right mono"><%= format_money(sale.change_cents) %></td></tr>
        </table>
        <% if sale.status == "refunded" %><div class="cancelled"><%= t("sale_statuses.refunded").upcase %></div><% end %>
      <% when "returns_legend" %>
        <div class="line-dotted"></div>
        <div data-ticket="ticket.returns_legend" data-empty="<%= t("till.refunds_only_with_ticket") %>"><%= settings["ticket.returns_legend"].presence || t("till.refunds_only_with_ticket") %></div>
      <% when "barcode" %>
        <div class="center <%= 'hidden' if settings["ticket.show_code"] != "1" %>" data-ticket="ticket.show_code"><%= ean13_svg(sale.code, height: 34, module_width: 2) %></div>
      <% when "footer" %>
        <div class="italic <%= 'hidden' if settings["business.ticket_footer"].blank? %>" data-ticket="business.ticket_footer"><%= settings["business.ticket_footer"] %></div>
      <% end %>
    </div>
  <% end %>
</div>
