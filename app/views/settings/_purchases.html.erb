<% if Features.active?("purchases") %>
  <%= form_with url: settings_system_path, method: :patch, class: "form" do |f| %>
    <%= hidden_field_tag :back, "purchases" %>
    <%= hidden_field_tag "setting[purchases.lock_received]", "0", id: nil %>
    <label class="flex items-center gap-3 text-sm"><%= check_box_tag "setting[purchases.lock_received]", "1", @settings["purchases.lock_received"] == "1" %> <%= t("settings.keys.purchases.lock_received") %></label>
    <p class="text-xs text-stone-500"><%= t("settings.lock_received_help") %></p>
    <%= f.submit t("settings.save"), class: "btn btn-primary btn-lg" %>
  <% end %>
<% else %>
  <p class="rounded bg-amber-50 p-4 text-sm"><%= t("settings.purchases_off") %> <%= link_to t("settings.sections.features"), settings_section_path("features"), class: "link" %></p>
<% end %>
