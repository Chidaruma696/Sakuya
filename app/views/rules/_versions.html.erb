<%# The versions of a Lisp rule, the one in force on top. scope = dashboard | rules (the texts come from there). %>
<section class="mt-8">
  <h2 class="mb-2 text-lg font-semibold"><%= t("#{scope}.versions") %></h2>
  <table class="table">
    <thead><tr><th><%= t("common.date") %></th><th><%= t("common.who") %></th><th></th></tr></thead>
    <tbody>
      <% versions.each_with_index do |v, i| %>
        <tr>
          <td class="px-3 py-2"><%= l v.created_at, format: :short %> <span class="text-xs text-stone-500" title="<%= t("rules.contract_help") %>"><%= t("rules.contract", n: v.version) %></span><% if i.zero? %> <span class="badge"><%= t("#{scope}.current") %></span><% end %></td>
          <td class="px-3 py-2"><%= v.user %></td>
          <td class="px-3 py-2 text-right"><% unless i.zero? %><%= button_to t("#{scope}.restore"), restore.(v), class: "btn btn-secondary btn-xs" %><% end %></td>
        </tr>
      <% end %>
      <% if versions.empty? %><tr><td colspan="3" class="px-3 py-6 text-center text-stone-500"><%= t("#{scope}.no_versions") %></td></tr><% end %>
    </tbody>
  </table>
</section>
