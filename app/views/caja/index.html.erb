<% if @corte.nil? %>
  <%= render "sin_caja" %>
<% else %>
  <% if @corte.excede_limite? %>
    <div class="mb-4 rounded border-l-4 border-red-600 bg-red-50 p-3 text-sm"><%= t("caja.excede_limite_html", monto: pesos(sucursal_actual.limite_efectivo_centavos), enlace: link_to(t("caja.haz_un_retiro"), caja_corte_path, class: "enlace")) %></div>
  <% end %>
  <div class="grid gap-4 lg:grid-cols-3" data-controller="pos" data-pos-escanear-url-value="<%= caja_escanear_path %>" data-pos-cobrar-url-value="<%= caja_cobrar_path %>" data-pos-clave-value="<%= @clave %>"<% if @pedido_pos %> data-pos-pedido-value="<%= @pedido_pos.to_json %>"<% end %>>
    <div class="lg:col-span-2">
      <div class="mb-3 flex gap-3">
        <input data-pos-target="codigo" data-action="keydown.enter->pos#escanear" autofocus autocomplete="off" placeholder="<%= t("caja.escanea_o_teclea") %>" class="flex-1 rounded border border-stone-300 px-3 py-3 font-mono text-lg">
      </div>
      <% if @pedido %>
        <div class="mb-2 rounded bg-blue-50 px-3 py-2 text-sm text-blue-900" id="cobrando_pedido"><%= t("pedidos.cobrando", folio: @pedido.folio, cliente: @pedido.cliente) %></div>
      <% end %>
      <div id="aviso" data-pos-target="aviso" class="mb-2 empty:hidden rounded bg-red-50 px-3 py-2 text-sm text-red-800"></div>
      <div data-pos-target="pendiente" class="mb-2 hidden rounded bg-blue-50 p-3 text-sm">
        <span data-pos-target="pendienteNombre" class="font-semibold"></span> ·
        <%= t("comun.cantidad").downcase %> <input data-pos-target="pendienteCantidad" data-action="keydown.enter->pos#confirmarPendiente" type="number" step="0.001" min="0.001" class="w-28 rounded border border-stone-300 px-2 py-1 font-mono">
        <button type="button" data-action="pos#confirmarPendiente" class="btn btn-primary btn-xs"><%= t("comun.agregar").downcase %></button>
        <button type="button" data-action="pos#cancelarPendiente" class="px-2 py-1 text-stone-500"><%= t("comun.cancelar").downcase %></button>
      </div>
      <table class="tabla">
        <thead><tr><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2 text-right"><%= t("comun.cantidad") %></th><th class="px-3 py-2 text-right"><%= t("comun.precio") %></th><th class="px-3 py-2 text-right"><%= t("comun.importe") %></th><th></th></tr></thead>
        <tbody data-pos-target="cuerpo"></tbody>
      </table>
    </div>
    <div class="card">
      <div class="etiqueta-dato"><%= t("comun.total") %></div>
      <div class="mb-4 valor-dato text-4xl" data-pos-target="total"><%= pesos(0) %></div>
      <div class="space-y-2 text-sm">
        <label class="flex items-center justify-between gap-2"><%= t("formas_pago.efectivo") %> <input data-pos-target="efectivo" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono"></label>
        <label class="flex items-center justify-between gap-2"><%= t("formas_pago.transferencia") %> <input data-pos-target="transferencia" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono"></label>
        <label class="flex items-center justify-between gap-2"><%= t("formas_pago.deposito") %> <input data-pos-target="deposito" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono"></label>
        <% if Modulo.activo?("clientes") %>
          <div class="space-y-2 border-t border-stone-200 pt-2">
            <label class="flex items-center justify-between gap-2"><%= t("caja.cliente") %>
              <%= select_tag :cliente_id, options_for_select([ [ t("caja.sin_cliente"), "" ] ] + Cliente.activos.order(:nombre).limit(500).map { |c| [ c.nombre, c.id ] }), data: { pos_target: "cliente" }, class: "w-40 rounded border border-stone-300 px-2 py-1" %></label>
            <label class="flex items-center justify-between gap-2"><%= t("formas_pago.credito") %> <input data-pos-target="credito" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono"></label>
          </div>
        <% end %>
        <div class="flex items-center justify-between border-t border-stone-200 pt-2"><%= t("caja.cambio") %> <span class="valor-dato text-xl" data-pos-target="cambio"><%= pesos(0) %></span></div>
      </div>
      <button type="button" data-action="pos#cobrar" data-pos-target="botonCobrar" class="btn btn-success btn-lg mt-4 w-full"><%= t("caja.cobrar") %></button>
      <button type="button" data-action="pos#vaciar" class="btn btn-secondary mt-2 w-full"><%= t("caja.vaciar_ticket") %></button>
      <p class="mt-3 text-xs text-stone-500"><%= t("caja.corte") %> <%= @corte.folio %> · <%= t("caja.en_gaveta").downcase %> <%= pesos(@corte.efectivo_esperado_centavos) %></p>
    </div>
  </div>
<% end %>
