<div class="mx-auto mt-6 max-w-2xl rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-stone-200">
  <i class="bi bi-cash-stack text-5xl text-marca-600"></i>
  <p class="mt-3 text-xl font-semibold"><%= t("caja.sin_caja_en", sucursal: sucursal_actual) %></p>
  <% if puede?("caja.abrir") %>
    <%= form_with url: caja_abrir_path, class: "mx-auto mt-5 flex max-w-sm flex-col items-stretch gap-3" do |f| %>
      <%= f.label :fondo, t("caja.fondo_inicial"), class: "text-left text-sm font-medium" %>
      <%= f.number_field :fondo, step: "0.01", min: 0, value: "0.00", required: true, class: "entrada mt-0 text-center font-mono text-2xl" %>
      <%= f.submit t("caja.abrir_caja"), class: "btn btn-primary btn-lg" %>
    <% end %>
  <% else %>
    <p class="mt-2 text-stone-600"><%= t("caja.pide_que_la_abran") %></p>
  <% end %>
</div>
