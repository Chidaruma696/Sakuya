<h1 class="mb-4 text-2xl font-bold"><%= t("caja.devolucion") %> · <%= sucursal_actual %></h1>
<%= form_with url: caja_devolucion_path, method: :get, class: "mb-4 flex gap-2" do |f| %>
  <%= f.text_field :codigo, value: params[:codigo], autofocus: true, autocomplete: "off", placeholder: t("caja.escanea_ticket"), class: "flex-1 rounded border border-stone-300 px-3 py-3 font-mono" %>
  <%= f.submit t("comun.buscar"), class: "btn btn-primary" %>
<% end %>
<% if @venta %>
  <%= form_with url: caja_devolver_path, class: "card" do |f| %>
    <%= f.hidden_field :venta_id, value: @venta.id %>
    <%= f.hidden_field :codigo, value: params[:codigo] %>
    <p class="mb-2 text-sm"><%= t("caja.ticket") %> <strong class="font-mono"><%= @venta.folio %></strong> · <%= l @venta.created_at, format: :short %> · <%= pesos(@venta.total_centavos) %> · <%= t("estados.#{@venta.estado}") %></p>
    <table class="w-full text-sm">
      <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2 text-right"><%= t("caja.vendido") %></th><th class="px-3 py-2 text-right"><%= t("caja.ya_devuelto") %></th><th class="px-3 py-2 text-right"><%= t("comun.precio") %></th><th class="px-3 py-2"><%= t("caja.devolver") %></th></tr></thead>
      <tbody>
        <% @venta.lineas.includes(:producto, :devolucion_lineas).each do |l| %>
          <tr class="border-t border-stone-100">
            <td class="px-3 py-2"><%= l.producto.nombre %></td>
            <td class="px-3 py-2 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td>
            <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.cantidad_devuelta, precision: l.producto.decimales) %></td>
            <td class="px-3 py-2 text-right font-mono"><%= pesos(l.precio_centavos) %></td>
            <td class="px-3 py-2"><% if l.cantidad_pendiente.positive? %><%= number_field_tag "lineas[#{l.id}]", nil, step: l.producto.fraccionable? ? "0.001" : "1", min: 0, max: l.cantidad_pendiente, class: "w-28 rounded border border-stone-300 px-2 py-1 font-mono" %><% else %><span class="text-stone-400"><%= t("comun.nada").delete(".") %></span><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="mt-3 flex items-end gap-3 text-sm">
      <div class="flex-1"><%= label_tag :motivo, t("comun.motivo"), class: "block" %><%= text_field_tag :motivo, nil, required: true, class: "w-full rounded border border-stone-300 px-3 py-2" %></div>
      <%= submit_tag t("caja.devolver_y_regresar"), class: "btn btn-danger" %>
    </div>
  <% end %>
<% end %>
