<h1 class="mb-4 text-2xl font-bold"><%= t("caja.corte_de_caja") %> · <%= sucursal_actual %></h1>
<% if @corte.nil? %>
  <%= render "sin_caja" %>
<% else %>
  <p class="mb-2 text-sm"><%= link_to t("caja.ver_resumen_abierto"), caja_resumen_path(@corte), target: "_blank", class: "enlace" %></p>
  <div class="grid gap-4 sm:grid-cols-4">
    <% [ [ t("caja.fondo"), @corte.fondo_centavos ], [ t("caja.ventas"), @corte.total_ventas_centavos ], [ t("caja.efectivo_de_ventas"), @corte.efectivo_ventas_centavos ], [ t("caja.devoluciones"), -@corte.devoluciones_centavos ], [ t("caja.retiros"), -@corte.retiros_centavos ], [ t("caja.en_gaveta"), @corte.efectivo_esperado_centavos ] ].each do |nombre, monto| %>
      <div class="card"><div class="etiqueta-dato"><%= nombre %></div><div class="valor-dato text-2xl"><%= pesos(monto) %></div></div>
    <% end %>
  </div>
  <p class="mt-2 text-sm text-stone-600"><%= t("caja.corte_abierto_por", folio: @corte.folio, quien: @corte.usuario, fecha: l(@corte.abierto_en, format: :short)) %> · <%= t("caja.n_ventas", count: @corte.ventas.count) %></p>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("caja.retiro_caja_fuerte") %></h2>
      <%= form_with url: caja_retirar_path, class: "space-y-2 text-sm" do |f| %>
        <%= f.number_field :monto, step: "0.01", min: "0.01", placeholder: t("caja.monto"), required: true, class: "w-full rounded border border-stone-300 px-3 py-2 font-mono" %>
        <%= f.text_field :motivo, placeholder: t("comun.motivo"), required: true, class: "w-full rounded border border-stone-300 px-3 py-2" %>
        <% unless puede?("caja.retirar") %><p class="text-xs text-stone-600"><%= t("caja.retiro_por_revisar") %></p><% end %>
        <%= f.submit t("caja.retirar"), class: "btn btn-primary" %>
      <% end %>
      <% if @corte.retiros.any? %>
        <ul class="mt-3 text-sm">
          <% @corte.retiros.includes(:usuario, :autorizado_por).each do |r| %>
            <li class="border-t border-stone-100 py-1"><%= l r.created_at, format: :short %> · <span class="font-mono"><%= pesos(r.monto_centavos) %></span> · <%= r.motivo %> · <%= t("comun.autorizo") %> <%= r.autorizado_por %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="card" data-controller="gaveta" data-gaveta-esperado-value="<%= @corte.efectivo_esperado_centavos %>" data-gaveta-tope-value="<%= Corte.tope_diferencia_centavos %>" data-gaveta-simbolo-value="<%= Ajuste.simbolo %>">
      <h2 class="mb-2 font-semibold"><%= t("caja.cerrar_corte") %></h2>
      <p class="mb-2 text-sm text-stone-600"><%= t("caja.cerrar_corte_ayuda") %></p>
      <%= form_with url: caja_cerrar_path, class: "space-y-3 text-sm", data: { turbo_confirm: t("caja.confirmar_cerrar_corte", folio: @corte.folio) } do |f| %>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
          <% Corte.denominaciones.each do |valor| %>
            <label class="flex items-center justify-between gap-2"><span class="font-mono text-stone-700"><%= pesos(valor) %></span>
              <%= number_field_tag "denominacion[#{valor}]", nil, min: 0, step: 1, inputmode: "numeric", class: "w-20 rounded border border-stone-300 px-2 py-1 text-right font-mono", data: { gaveta_target: "cantidad", valor: valor, action: "input->gaveta#sumar" } %></label>
          <% end %>
        </div>
        <div class="flex flex-wrap items-end gap-4 border-t border-stone-100 pt-3">
          <div><%= f.label :contado, t("caja.efectivo_contado"), class: "block" %><%= f.number_field :contado, step: "0.01", min: 0, required: true, class: "rounded border border-stone-300 px-3 py-2 font-mono", data: { gaveta_target: "contado", action: "input->gaveta#tecleado" } %></div>
          <div><div class="etiqueta-dato"><%= t("caja.suma") %></div><div class="valor-dato text-lg" data-gaveta-target="suma"><%= pesos(0) %></div></div>
          <div><div class="etiqueta-dato"><%= t("caja.diferencia") %></div><div class="valor-dato text-lg" data-gaveta-target="diferencia"><%= pesos(-@corte.efectivo_esperado_centavos) %></div></div>
        </div>
        <% if Corte.tope_diferencia_centavos.positive? %>
          <div class="hidden" data-gaveta-target="motivo">
            <p class="mb-1 text-xs text-amber-700"><%= t("caja.tope_diferencia_aviso", monto: pesos(Corte.tope_diferencia_centavos)) %><%= " " + t("caja.retiro_por_revisar") unless puede?("caja.diferencia") %></p>
            <%= f.text_field :motivo, placeholder: t("caja.motivo_diferencia"), class: "w-full rounded border border-stone-300 px-3 py-2" %>
          </div>
        <% end %>
        <%= f.submit t("caja.cerrar_corte"), class: "btn btn-danger" %>
      <% end %>
    </div>
  </div>
<% end %>
<% if @cortes.any? %>
  <h2 class="mb-2 mt-8 font-semibold"><%= t("caja.cortes_cerrados") %></h2>
  <table class="tabla">
    <thead><tr><th class="px-3 py-2"><%= t("comun.folio") %></th><th class="px-3 py-2"><%= t("caja.abierto") %></th><th class="px-3 py-2"><%= t("caja.cerrado") %></th><th class="px-3 py-2"><%= t("caja.cajero") %></th><th class="px-3 py-2 text-right"><%= t("caja.esperado") %></th><th class="px-3 py-2 text-right"><%= t("caja.contado") %></th><th class="px-3 py-2 text-right"><%= t("caja.diferencia") %></th><th></th></tr></thead>
    <tbody>
      <% @cortes.each do |c| %>
        <tr class="border-t border-stone-100">
          <td class="px-3 py-2 font-mono"><%= c.folio %></td>
          <td class="px-3 py-2"><%= l c.abierto_en, format: :short %></td>
          <td class="px-3 py-2"><%= l(c.cerrado_en, format: :short) if c.cerrado_en %></td>
          <td class="px-3 py-2"><%= c.usuario %></td>
          <td class="px-3 py-2 text-right font-mono"><%= pesos(c.esperado_centavos) %></td>
          <td class="px-3 py-2 text-right font-mono" title="<%= c.desglose_texto %>"><%= pesos(c.contado_centavos) %></td>
          <td class="px-3 py-2 text-right font-mono <%= c.diferencia_centavos.to_i.negative? ? 'text-red-700' : 'text-green-700' %>"><%= pesos(c.diferencia_centavos) %></td>
          <td class="px-3 py-2 text-right"><%= link_to t("caja.ver_resumen"), caja_resumen_path(c), target: "_blank", class: "btn btn-secondary btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
