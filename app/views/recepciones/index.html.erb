<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("compras.recepciones") %></h1>
  <%= link_to icono("box-arrow-in-down", t("compras.recibir")), new_recepcion_path, class: "btn btn-primary" if puede?("compras.recibir") %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("compras.recepciones_ayuda", sucursal: sucursal_actual) %></p>
<table class="tabla">
  <thead><tr><th><%= t("comun.folio") %></th><th><%= t("comun.fecha") %></th><th><%= t("compras.proveedor") %></th><th><%= t("compras.remision") %></th><th><%= t("compras.factura") %></th><th class="text-right"><%= t("compras.renglones") %></th><th><%= t("comun.quien") %></th><th><%= t("comun.estado") %></th></tr></thead>
  <tbody>
    <% @recepciones.each do |r| %>
      <tr class="<%= 'text-stone-400 line-through' if r.cancelada? %>">
        <td class="px-3 py-2"><%= link_to r.folio, recepcion_path(r), class: "chip-folio" %></td>
        <td class="px-3 py-2 whitespace-nowrap"><%= l r.fecha %></td>
        <td class="px-3 py-2"><%= r.proveedor %></td><td class="px-3 py-2 font-mono text-xs"><%= r.remision %></td>
        <td class="px-3 py-2"><%= r.factura ? link_to(r.factura.folio, factura_path(r.factura), class: "chip-folio") : tag.span(t("compras.sin_factura"), class: "text-xs text-amber-700") %></td>
        <td class="px-3 py-2 text-right font-mono"><%= r.lineas.size %></td>
        <td class="px-3 py-2"><%= r.usuario %></td>
        <td class="px-3 py-2"><%= t("compras.estados.#{r.estado}") %></td>
      </tr>
    <% end %>
    <% if @recepciones.empty? %><tr><td colspan="8" class="px-3 py-6 text-center text-stone-500"><%= t("compras.sin_recepciones") %></td></tr><% end %>
  </tbody>
</table>
