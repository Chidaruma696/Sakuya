<% r = @recepcion %>
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("compras.recepcion") %> <span class="font-mono"><%= r.folio %></span><%= tag.span(" · #{t("compras.estados.cancelada")}", class: "text-red-700") if r.cancelada? %></h1>
  <%= link_to icono("arrow-left", t("compras.recepciones")), recepciones_path, class: "btn btn-ghost btn-sm" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= r.proveedor %> · <%= l r.fecha %> · <%= r.sucursal %> · <%= r.usuario %><%= " · #{t("compras.remision").downcase} #{r.remision}" if r.remision.present? %><%= " · #{r.notas}" if r.notas.present? %><%= " · #{r.motivo_cancelacion}" if r.cancelada? %></p>
<div class="grid gap-4 lg:grid-cols-3">
  <div class="card lg:col-span-2">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="py-1 text-right"><%= t("comun.cantidad") %></th><th class="py-1 text-right"><%= t("compras.cajas") %></th></tr></thead>
      <tbody>
        <% r.lineas.each do |l| %>
          <tr class="border-t border-stone-100"><td class="py-1"><%= l.producto.nombre %></td><td class="py-1 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td><td class="py-1 text-right font-mono"><%= l.cajas unless l.cajas.zero? %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="space-y-4">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("compras.factura") %></h2>
      <% if r.factura %>
        <p class="text-sm"><%= link_to r.factura.folio, factura_path(r.factura), class: "chip-folio" %> · <%= pesos(r.factura.monto_centavos) %></p>
      <% else %>
        <p class="text-sm text-amber-700"><%= t("compras.sin_factura_aun") %></p>
      <% end %>
      <% if r.registrada? && puede?("compras.facturar") %>
        <%= form_with url: factura_recepcion_path(r), method: :patch, class: "mt-3 flex flex-wrap gap-2 text-sm" do |f| %>
          <%= f.select :factura_proveedor_id, @facturas.map { |x| [ "#{x.folio} · #{pesos(x.monto_centavos)} · #{l x.fecha}", x.id ] }, { include_blank: t("compras.ninguna"), selected: r.factura_proveedor_id }, class: "entrada mt-0 flex-1" %>
          <%= f.submit t("compras.ligar"), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <%= link_to icono("file-earmark-plus", t("compras.capturar_factura")), new_factura_path(proveedor_id: r.proveedor_id), class: "btn btn-ghost btn-sm mt-2" %>
      <% end %>
    </div>
    <% if r.registrada? && puede?("compras.recibir") %>
      <div class="card">
        <h2 class="mb-2 font-semibold"><%= t("compras.cancelar_recepcion") %></h2>
        <p class="mb-2 text-xs text-stone-500"><%= t("compras.cancelar_recepcion_ayuda") %></p>
        <%= form_with url: cancelar_recepcion_path(r), class: "flex flex-wrap gap-2 text-sm", data: { turbo_confirm: t("compras.confirmar_cancelar", folio: r.folio) } do |f| %>
          <%= f.text_field :motivo, placeholder: t("comun.motivo").downcase, required: true, class: "entrada mt-0 flex-1" %>
          <%= f.submit t("comun.cancelar"), class: "btn btn-ghost-danger btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
